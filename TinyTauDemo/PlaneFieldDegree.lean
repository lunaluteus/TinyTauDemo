module

public import TinyTauDemo.PolynomialTuplePoles
public import TauCeti.FieldTheory.FunctionField.Divisor.Conorm
public import TauCeti.RingTheory.MvPolynomial.Dehomogenization
import TauCeti.FieldTheory.FunctionField.PlaneCurve.Projective
import TauCeti.FieldTheory.FunctionField.PlaneCurve.Basic
import TauCeti.RingTheory.MvPolynomial.LinearSubst
import TauCeti.FieldTheory.FunctionField.Basic

/-!
# Degree of the field generated by plane polynomial coordinates

See `/roadmap/index.qmd#rem-scheme-curves-recall @ 0ce794f8b09e1d3bf189ed3c18dd9c1894d2a4a7`.
-/

public section

open Polynomial MvPolynomial IntermediateField TauCeti TauCeti.AlgebraicGeometry
open scoped IntermediateField Matrix

namespace TinyTauDemo

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]
  {d : ℕ} {F : MvPolynomial (Fin 3) k}

omit [IsAlgClosed k] in
/-- The supremum of two pole divisors is preserved by divisor conorm. -/
private theorem conorm_sup_poles {E : Type u} [Field E] [Algebra k E]
    [Algebra E (RatFunc k)] [IsScalarTower k E (RatFunc k)] [FiniteDimensional E (RatFunc k)]
    (hE : IsFunctionField k E) (a b : Eˣ) :
    Divisor.conorm k (RatFunc k) (Divisor.poles hE a ⊔ Divisor.poles hE b) =
      rationalPoleDivisor (algebraMap E (RatFunc k) (a : E)) ⊔
        rationalPoleDivisor (algebraMap E (RatFunc k) (b : E)) := by
  let f : E →* RatFunc k := algebraMap E (RatFunc k)
  change _ = rationalPoleDivisor ((Units.map f a : (RatFunc k)ˣ) : RatFunc k) ⊔
    rationalPoleDivisor ((Units.map f b : (RatFunc k)ˣ) : RatFunc k)
  rw [rationalPoleDivisor_coe_unit, rationalPoleDivisor_coe_unit,
    ← Divisor.conorm_poles k (RatFunc k) hE (IsFunctionField.ratFunc k),
    ← Divisor.conorm_poles k (RatFunc k) hE (IsFunctionField.ratFunc k)]
  refine WeilDivisor.ext fun P ↦ ?_
  rw [Divisor.coeff_conorm, WeilDivisor.coeff_sup, WeilDivisor.coeff_sup,
    Divisor.coeff_conorm, Divisor.coeff_conorm]
  exact mul_max_of_nonneg _ _ (Int.natCast_nonneg _)

omit [IsAlgClosed k] in
private theorem rationalPoleDivisor_zero :
    rationalPoleDivisor (0 : RatFunc k) = 0 := by
  ext P
  simp [rationalPoleDivisor_coeff]

omit [IsAlgClosed k] in
private theorem rationalPoleDivisor_one :
    rationalPoleDivisor (1 : RatFunc k) = 0 := by
  ext P
  simp [rationalPoleDivisor_coeff]

omit [IsAlgClosed k] in
private theorem normalized_eval_last {s : Type u} [Field s] [Algebra k s]
    (F : MvPolynomial (Fin 3) k) (a b : s) :
    aeval ![a, b] (dehomogenize 2 F) = aeval ![a, b, 1] F := by
  rw [aeval_dehomogenize]
  have h : (2 : Fin 3).insertNth (1 : s) ![a, b] = ![a, b, 1] := by
    ext j
    fin_cases j <;> rfl
  rw [h]

/-- The corrected degree formula for the field generated by two ratios of a primitive
polynomial tuple. The first ratio can be chosen as the transcendental coordinate, and the
other numerator may vanish identically. -/
theorem max_natDegree_eq_mul_finrank_planeCoordinateField
    (hF : F.IsHomogeneous d) (hF₀ : F ≠ 0)
    (hJac : ∀ c : Fin 3 → k, c ≠ 0 → aeval c F = 0 → ∃ j, aeval c (pderiv j F) ≠ 0)
    {x y z : k[X]} (hspan : Ideal.span ({x, y, z} : Set k[X]) = ⊤) (hz : z ≠ 0)
    (ha : Transcendental k (polynomialRatio x z))
    (hrel : aeval ![polynomialRatio x z, polynomialRatio y z, (1 : RatFunc k)] F = 0) :
    max x.natDegree (max y.natDegree z.natDegree) =
      d * Module.finrank k⟮polynomialRatio x z, polynomialRatio y z⟯ (RatFunc k) := by
  let a := polynomialRatio x z
  let b := polynomialRatio y z
  let E := k⟮a, b⟯
  let a₀ := AdjoinPair.gen₁ k a b
  let b₀ := AdjoinPair.gen₂ k a b
  have htr : Transcendental k a₀ :=
    (transcendental_algebraMap_iff (algebraMap E (RatFunc k)).injective).mp ha
  have ha₀ : a₀ ≠ 0 := by
    intro h
    exact htr (h ▸ isAlgebraic_zero)
  have hgen : k⟮a₀, b₀⟯ = ⊤ := by
    apply IntermediateField.lift_injective E
    rw [IntermediateField.lift_adjoin, Set.image_pair, IntermediateField.lift_top]
    rfl
  have hrel₀ : aeval ![a₀, b₀, (1 : E)] F = 0 := by
    apply (algebraMap E (RatFunc k)).injective
    rw [map_zero, ← IsScalarTower.coe_toAlgHom' k E (RatFunc k),
      MvPolynomial.comp_aeval_apply]
    have hcoords : (fun i ↦ IsScalarTower.toAlgHom k E (RatFunc k)
        (![a₀, b₀, (1 : E)] i)) = ![a, b, (1 : RatFunc k)] := by
      ext i
      fin_cases i <;> rfl
    rw [hcoords]
    exact hrel
  have hg : dehomogenize 2 F ≠ 0 := by
    intro hef
    apply hF₀
    apply dehomogenize_injOn 2 d hF (isHomogeneous_zero _ _ _)
    rw [hef, map_zero]
  let hE := isFunctionField_of_aeval_eq_zero hg htr hgen
    ((normalized_eval_last F a₀ b₀).trans hrel₀)
  have : Algebra.IsAlgebraic E (RatFunc k) :=
    hE.isAlgebraic_of_isFunctionField (IsFunctionField.ratFunc k)
  have : Algebra.EssFiniteType k (RatFunc k) := (IsFunctionField.ratFunc k).essFiniteType
  have : Algebra.EssFiniteType E (RatFunc k) := Algebra.EssFiniteType.of_comp k E (RatFunc k)
  let : FiniteDimensional E (RatFunc k) := Algebra.finite_of_essFiniteType_of_isAlgebraic
  let A := Units.mk0 a₀ ha₀
  have hsrc : Divisor.degree (rationalPoleDivisor a ⊔ rationalPoleDivisor b) =
      max x.natDegree (max y.natDegree z.natDegree) :=
    rationalPoleDivisor_ratio_sup_degree hspan hz
  have hcon (B : Eˣ) (hB : rationalPoleDivisor (algebraMap E (RatFunc k) (B : E)) =
      rationalPoleDivisor b)
      (hdeg : Divisor.degree (Divisor.poles hE A ⊔ Divisor.poles hE B) = (d : ℤ)) :
      max x.natDegree (max y.natDegree z.natDegree) =
        d * Module.finrank E (RatFunc k) := by
    have hdc := Divisor.degree_conorm_of_finrank_eq_one k (RatFunc k) hE
      (Module.finrank_self k) (Divisor.poles hE A ⊔ Divisor.poles hE B)
    rw [conorm_sup_poles hE A B, hB, hdeg] at hdc
    change Divisor.degree (rationalPoleDivisor a ⊔ rationalPoleDivisor b) = _ at hdc
    rw [hsrc, mul_comm] at hdc
    exact_mod_cast hdc
  by_cases h₀ : b₀ = 0
  · let M : Matrix (Fin 3) (Fin 3) k := !![1, 0, 0; 0, 1, -1; 0, 0, 1]
    let G := linearSubst M F
    have hG : G.IsHomogeneous d := hF.linearSubst M
    have hdet : M.det ≠ 0 := by simp [M, Matrix.det_fin_three]
    have hJacG (c : Fin 3 → k) (hc : c ≠ 0) (hcG : aeval c G = 0) :
        ∃ j, aeval c (pderiv j G) ≠ 0 :=
      exists_aeval_pderiv_linearSubst_ne_zero hdet hJac hc hcG
    have hGrel : aeval ![a₀, (1 : E), 1] G = 0 := by
      rw [show G = linearSubst M F from rfl, aeval_linearSubst]
      have hcoords : (M.map (algebraMap k E)) *ᵥ ![a₀, (1 : E), 1] = ![a₀, b₀, 1] := by
        ext j
        fin_cases j <;> simp [M, Matrix.mulVec, dotProduct, Fin.sum_univ_three, h₀]
      rw [hcoords]
      exact hrel₀
    have hgen' : k⟮a₀, (1 : E)⟯ = ⊤ := by
      apply top_unique
      rw [← hgen, adjoin_le_iff, Set.insert_subset_iff, Set.singleton_subset_iff, h₀]
      exact ⟨mem_adjoin_pair_left _ _ _, zero_mem _⟩
    apply hcon 1
    · have hb : b = 0 := congrArg (algebraMap E (RatFunc k)) h₀
      rw [show (algebraMap E (RatFunc k)) ((1 : Eˣ) : E) = 1 by simp, hb,
        rationalPoleDivisor_one, rationalPoleDivisor_zero]
    · exact degree_sup_poles_of_isHomogeneous (K := k) hE hG hJacG
        (x := A) (y := 1) htr hgen' hGrel
  · let B := Units.mk0 b₀ h₀
    exact hcon B rfl (degree_sup_poles_of_isHomogeneous (K := k) hE hF hJac
      (x := A) (y := B) htr hgen hrel₀)

end TinyTauDemo
