module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic

/-!
# The cyclotomic ring of integers

Mathlib's `IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton` identifies the
ring of integers. The calculation below changes the generator from `ζ` to `1 - ζ`.
See `/roadmap/index.qmd#thm-ring-of-integers @ b2085edbc02b6c8a70cd3a33e73a54dbb0e26de4`.
-/

public section

private theorem adjoin_one_sub {A : Type*} [Ring A] (x : A) :
    Algebra.adjoin ℤ ({1 - x} : Set A) = Algebra.adjoin ℤ ({x} : Set A) := by
  have h (y : A) : Algebra.adjoin ℤ ({1 - y} : Set A) ≤ Algebra.adjoin ℤ ({y} : Set A) :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr (sub_mem (one_mem _)
      (Algebra.subset_adjoin (Set.mem_singleton y))))
  exact le_antisymm (h x) (by simpa only [sub_sub_cancel] using h (1 - x))

/-- In a rational cyclotomic field, the subalgebra generated by one minus a primitive
root of unity is the ring of integers. -/
theorem IsPrimitiveRoot.isIntegralClosure_adjoin_one_sub {K : Type*} [Field K] [CharZero K]
    {p : ℕ} [NeZero p] [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p) :
    IsIntegralClosure (Algebra.adjoin ℤ ({1 - ζ} : Set K)) ℤ K := by
  have h := congrArg (fun S : Subalgebra ℤ K => IsIntegralClosure S ℤ K) (adjoin_one_sub ζ)
  exact h.mpr (IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton hζ)
