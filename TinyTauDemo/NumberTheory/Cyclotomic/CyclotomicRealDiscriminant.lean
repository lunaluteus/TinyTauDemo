import Mathlib.Algebra.Polynomial.Degree.SmallDegree
import TauCeti.RingTheory.DedekindDomain.Different.Monogenic

/-!
# Discriminants of prime cyclotomic fields and their real subfields

The primitive root generates the ring of integers over the maximal real subfield's ring of
integers. Its quadratic minimal polynomial has derivative `ζ - ζ⁻¹` at the root, and this
derivative generates a different of absolute norm `p`.

See `/roadmap/index.qmd#rem-bernoulli-regular` @ `f606bbe053030c54bf1ead8056feefc1a552d822`.
-/

public section

open ComplexConjugate NumberField Polynomial
open scoped NumberField

namespace TinyTauDemo

variable {K : Type*} [Field K] [NumberField K] {p : ℕ} [hp : Fact p.Prime]
  [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p)

local notation "K⁺" => maximalRealSubfield K

private theorem isCMField_of_odd_prime_cyclotomic (hp2 : p ≠ 2) : IsCMField K := by
  have hpge := hp.out.two_le
  exact IsCyclotomicExtension.Rat.isCMField (S := {p}) K ⟨p, rfl, by omega⟩

/-- The ring of integers of a prime cyclotomic field is generated by its primitive root over
the ring of integers of its maximal real subfield. -/
theorem cyclotomic_adjoin_real_ringOfIntegers_eq_top :
    Algebra.adjoin (𝓞 K⁺) ({hζ.toInteger} : Set (𝓞 K)) = ⊤ := by
  apply Subalgebra.restrictScalars_injective ℤ
  rw [Subalgebra.restrictScalars_top, ← top_le_iff,
    ← IsCyclotomicExtension.Rat.adjoin_singleton_eq_top hζ]
  exact Algebra.adjoin_le (fun _ hx ↦ Algebra.subset_adjoin hx)

include hζ in
omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem zeta_add_inv_mem_maximalRealSubfield : ζ + ζ⁻¹ ∈ maximalRealSubfield K := by
  rw [mem_maximalRealSubfield_iff]
  intro φ
  change conj (φ (ζ + ζ⁻¹)) = φ (ζ + ζ⁻¹)
  rw [map_add, map_inv₀]
  have hz : (φ ζ) ^ p = 1 := by rw [← map_pow, hζ.pow_eq_one, map_one]
  have hc := Complex.inv_eq_conj (Complex.norm_eq_one_of_pow_eq_one hz hp.out.ne_zero)
  have hc' : conj ((φ ζ)⁻¹) = φ ζ := by rw [hc, Complex.conj_conj]
  rw [map_add, hc', ← hc, add_comm]

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private noncomputable def cyclotomic_realTrace : 𝓞 K⁺ := by
  let a : K⁺ := ⟨ζ + ζ⁻¹, zeta_add_inv_mem_maximalRealSubfield hζ⟩
  exact ⟨a, (isIntegral_algHom_iff (IsScalarTower.toAlgHom ℤ K⁺ K)
    (algebraMap K⁺ K).injective).mp
    ((hζ.isIntegral hp.out.pos).add (hζ.inv.isIntegral hp.out.pos))⟩

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem coe_realTrace :
    algebraMap (𝓞 K⁺) K (cyclotomic_realTrace hζ) = ζ + ζ⁻¹ := rfl

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private noncomputable def cyclotomic_quadratic : (𝓞 K⁺)[X] :=
  X ^ 2 + C (-cyclotomic_realTrace hζ) * X + C 1

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem cyclotomic_quadratic_natDegree : (cyclotomic_quadratic hζ).natDegree = 2 := by
  simpa only [cyclotomic_quadratic, C_1, one_mul] using
    (natDegree_quadratic (b := -cyclotomic_realTrace hζ) (c := 1)
      (one_ne_zero : (1 : 𝓞 K⁺) ≠ 0))

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem cyclotomic_quadratic_monic : (cyclotomic_quadratic hζ).Monic := by
  rw [Monic, leadingCoeff, cyclotomic_quadratic_natDegree, cyclotomic_quadratic]
  simp [coeff_X_pow, coeff_one]

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem aeval_cyclotomic_quadratic : aeval hζ.toInteger (cyclotomic_quadratic hζ) = 0 := by
  apply RingOfIntegers.coe_injective
  simp only [cyclotomic_quadratic, map_add, map_pow, aeval_X, map_mul, aeval_C,
    ← IsScalarTower.algebraMap_apply, map_neg, coe_realTrace, map_one, map_zero]
  change ζ ^ 2 + -(ζ + ζ⁻¹) * ζ + 1 = 0
  field_simp [hζ.ne_zero hp.out.ne_zero]
  ring

private theorem cyclotomic_real_minpoly_natDegree (hp2 : p ≠ 2) :
    (minpoly (𝓞 K⁺) hζ.toInteger).natDegree = 2 := by
  have : IsCMField K := isCMField_of_odd_prime_cyclotomic (K := K) hp2
  have hint : IsIntegral (𝓞 K⁺) hζ.toInteger := (RingOfIntegers.isIntegral _).tower_top
  have hq : IntermediateField.adjoin ℚ ({ζ} : Set K) = ⊤ := by
    rw [IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
      (fun x _ ↦ IsAlgebraic.of_finite ℚ x)]
    exact IsCyclotomicExtension.adjoin_primitive_root_eq_top hζ
  have ha : IntermediateField.adjoin K⁺ ({ζ} : Set K) = ⊤ :=
    IntermediateField.adjoin_eq_top_of_adjoin_eq_top ℚ hq
  have hdeg := IntermediateField.adjoin.finrank (IsIntegral.of_finite K⁺ ζ)
  rw [ha, IntermediateField.finrank_top', Algebra.IsQuadraticExtension.finrank_eq_two] at hdeg
  rw [← natDegree_map_eq_of_injective (IsFractionRing.injective (𝓞 K⁺) K⁺),
    ← minpoly.isIntegrallyClosed_eq_field_fractions K⁺ K hint]
  exact hdeg.symm

private theorem cyclotomic_real_minpoly (hp2 : p ≠ 2) :
    minpoly (𝓞 K⁺) hζ.toInteger = cyclotomic_quadratic hζ := by
  have hint : IsIntegral (𝓞 K⁺) hζ.toInteger := (RingOfIntegers.isIntegral _).tower_top
  symm
  apply eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) (cyclotomic_quadratic_monic hζ)
    (minpoly.isIntegrallyClosed_dvd hint (aeval_cyclotomic_quadratic hζ))
  rw [cyclotomic_quadratic_natDegree, cyclotomic_real_minpoly_natDegree hζ hp2]

/-- In an odd-prime cyclotomic field the relative different over the maximal real subfield
is generated by the primitive root minus its inverse. -/
theorem cyclotomic_real_differentIdeal_eq_span (hp2 : p ≠ 2) :
    differentIdeal (𝓞 K⁺) (𝓞 K) = Ideal.span {hζ.toInteger - hζ.inv.toInteger} := by
  rw [TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly (𝓞 K⁺) K⁺ K (𝓞 K)
    hζ.toInteger (cyclotomic_adjoin_real_ringOfIntegers_eq_top hζ), cyclotomic_real_minpoly hζ hp2]
  congr 2
  apply RingOfIntegers.coe_injective
  simp only [cyclotomic_quadratic, map_add, derivative_pow, derivative_X, mul_one,
    derivative_mul, derivative_C, neg_zero, zero_mul, zero_add, add_zero, map_mul, map_pow,
    aeval_X, aeval_C, ← IsScalarTower.algebraMap_apply, map_natCast, map_neg, coe_realTrace,
    map_sub]
  change (2 : K) * ζ ^ (2 - 1) + -(ζ + ζ⁻¹) = ζ - ζ⁻¹
  ring

/-- The relative different over the maximal real subfield has absolute norm equal
to the odd cyclotomic conductor. -/
theorem cyclotomic_real_differentIdeal_absNorm (hp2 : p ≠ 2) :
    Ideal.absNorm (differentIdeal (𝓞 K⁺) (𝓞 K)) = p := by
  let z := IsCyclotomicExtension.zeta p ℚ K
  have hζ : IsPrimitiveRoot z p := IsCyclotomicExtension.zeta_spec p ℚ K
  have hcop : Nat.Coprime 2 p := (hp.out.coprime_iff_not_dvd.mpr
    (fun h ↦ hp2 (((Nat.dvd_prime Nat.prime_two).mp h).resolve_left hp.out.ne_one))).symm
  have hinv : IsUnit (hζ.inv.toInteger) := hζ.inv.toInteger_isPrimitiveRoot.isUnit hp.out.ne_zero
  have hninv : (Algebra.norm ℤ hζ.inv.toInteger).natAbs = 1 :=
    Int.isUnit_iff_natAbs_eq.mp (hinv.map (Algebra.norm ℤ))
  have heq : hζ.toInteger - hζ.inv.toInteger =
      hζ.inv.toInteger * ((hζ.pow_of_coprime 2 hcop).toInteger - 1) := by
    apply RingOfIntegers.coe_injective
    rw [map_sub, map_mul, map_sub, map_one]
    change z - z⁻¹ = z⁻¹ * (z ^ 2 - 1)
    field_simp [hζ.ne_zero hp.out.ne_zero]
  rw [cyclotomic_real_differentIdeal_eq_span hζ hp2, heq, Ideal.absNorm_span_singleton,
    map_mul, Int.natAbs_mul, hninv, one_mul,
    (hζ.pow_of_coprime 2 hcop).norm_toInteger_sub_one_of_prime_ne_two' hp2, Int.natAbs_natCast]

/-- The absolute discriminant of an odd-prime cyclotomic field is the conductor times
the square of the absolute discriminant of its maximal real subfield. -/
theorem cyclotomic_discr_natAbs_eq_prime_mul_real_discr_sq (hp2 : p ≠ 2) :
    (discr K).natAbs = p * (discr K⁺).natAbs ^ 2 := by
  have : IsCMField K := isCMField_of_odd_prime_cyclotomic (K := K) hp2
  have hd := congrArg Ideal.absNorm (TauCeti.relDiscr_tower (A := ℤ) (B := 𝓞 K⁺) (C := 𝓞 K))
  have hfin : Module.finrank (𝓞 K⁺) (𝓞 K) = 2 := by
    rw [← IsFractionRing.finrank_eq (𝓞 K⁺) K⁺ (𝓞 K) K,
      Algebra.IsQuadraticExtension.finrank_eq_two]
  rw [map_mul, map_pow, Ideal.absNorm_relNorm ℤ, TauCeti.relDiscr_def (A := 𝓞 K⁺),
    Ideal.absNorm_relNorm (𝓞 K⁺), hfin, cyclotomic_real_differentIdeal_absNorm (K := K) hp2,
    TauCeti.NumberField.relDiscr_int_ringOfIntegers,
    TauCeti.NumberField.relDiscr_int_ringOfIntegers] at hd
  simpa only [Ideal.absNorm_span_singleton, Algebra.norm_self, MonoidHom.id_apply, mul_comm]
    using hd


private theorem cyclotomic_discr_natAbs :
    (discr K).natAbs = p ^ (p - 2) := by
  simp [IsCyclotomicExtension.Rat.discr_prime p K, Int.natAbs_mul, Int.natAbs_pow]

/-- The absolute discriminant of the maximal real subfield of an odd-prime cyclotomic
field is the conductor to the power `(p - 3) / 2`. -/
theorem cyclotomic_real_discr_natAbs (hp2 : p ≠ 2) :
    (discr K⁺).natAbs = p ^ ((p - 3) / 2) := by
  obtain ⟨m, hm⟩ := hp.out.odd_of_ne_two hp2
  have hpge := hp.out.two_le
  have hpow : (p - 3) / 2 * 2 + 1 = p - 2 := by omega
  have heq : p * (discr K⁺).natAbs ^ 2 = p * (p ^ ((p - 3) / 2)) ^ 2 := by
    rw [← cyclotomic_discr_natAbs_eq_prime_mul_real_discr_sq (K := K) hp2,
      cyclotomic_discr_natAbs (p := p), ← pow_mul p _ 2, ← pow_succ', hpow]
  exact pow_left_injective (by decide : 2 ≠ 0) (Nat.eq_of_mul_eq_mul_left hp.out.pos heq)

/-- The square-root discriminant factor in the ratio of the cyclotomic and real-subfield
Dedekind-zeta residues. -/
theorem cyclotomic_real_sqrt_discr_div (hp2 : p ≠ 2) :
    Real.sqrt |(discr K⁺ : ℝ)| / Real.sqrt |(discr K : ℝ)| =
      1 / Real.sqrt ((p : ℝ) ^ ((p - 1) / 2)) := by
  obtain ⟨m, hm⟩ := hp.out.odd_of_ne_two hp2
  have hpge := hp.out.two_le
  have hpow : (p - 3) / 2 + (p - 1) / 2 = p - 2 := by omega
  have hd : (discr K).natAbs = (discr K⁺).natAbs * p ^ ((p - 1) / 2) := by
    rw [cyclotomic_discr_natAbs (p := p), cyclotomic_real_discr_natAbs hp2, ← pow_add, hpow]
  have hd' : |(discr K : ℝ)| = |(discr K⁺ : ℝ)| * (p : ℝ) ^ ((p - 1) / 2) := by
    simpa only [Nat.cast_mul, Nat.cast_pow, Nat.cast_natAbs, Int.cast_abs] using
      congrArg (fun n : ℕ ↦ (n : ℝ)) hd
  have hpos : 0 < Real.sqrt |(discr K⁺ : ℝ)| :=
    Real.sqrt_pos_of_pos (abs_pos.mpr (Int.cast_ne_zero.mpr (discr_ne_zero K⁺)))
  rw [hd', Real.sqrt_mul (abs_nonneg _), div_mul_eq_div_div, div_self hpos.ne']

end TinyTauDemo
