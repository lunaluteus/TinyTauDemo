module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Galois
public import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal

/-!
# Ramification at an odd cyclotomic prime

Mathlib gives the irreducibility of the cyclotomic polynomial over `ℚ`, the field degree,
and the Galois action in `Polynomial.cyclotomic.irreducible_rat`,
`IsCyclotomicExtension.Rat.finrank`, and `IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq`.
We identify the ramified ideal and residue field using the generator `1 - ζ`.
The ramification index and residue degree are computed in Mathlib's
`IsCyclotomicExtension.Rat.ramificationIdx_eq_of_prime` and `inertiaDeg_eq_of_prime`.
See `/roadmap/index.qmd#prp-cyclotomic-ramification @ 4b39b0e1282d8246130146d6ab52909c731e7469`.
-/

namespace IsPrimitiveRoot

open NumberField

variable {K : Type*} [Field K] [NumberField K] {p : ℕ} [hp : Fact p.Prime]
  [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p)

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
/-- The two sign conventions for the cyclotomic uniformizer generate the same ideal. -/
public theorem span_one_sub_eq_span_zeta_sub_one :
    Ideal.span ({1 - hζ.toInteger} : Set (𝓞 K)) = Ideal.span {hζ.toInteger - 1} := by
  rw [Ideal.span_singleton_eq_span_singleton, ← neg_sub, Associated.neg_left_iff]

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
/-- The rational prime generates the `(p - 1)`-st power of the cyclotomic prime ideal. -/
public theorem span_natCast_eq_span_one_sub_pow :
    Ideal.span ({(p : 𝓞 K)} : Set (𝓞 K)) = Ideal.span {1 - hζ.toInteger} ^ (p - 1) := by
  rw [hζ.span_one_sub_eq_span_zeta_sub_one, Ideal.span_singleton_pow,
    Ideal.span_singleton_eq_span_singleton]
  exact (IsCyclotomicExtension.Rat.associated_zeta_sub_one_pow_prime p hζ).symm

/-- The unique prime over the rational prime is generated by one minus the primitive root. -/
public theorem primesOver_span_natCast_eq_singleton_one_sub :
    Ideal.primesOver (Ideal.span {(p : ℤ)}) (𝓞 K) = {Ideal.span {1 - hζ.toInteger}} := by
  rw [hζ.span_one_sub_eq_span_zeta_sub_one]
  ext P
  constructor
  · intro hP
    have : P.IsPrime := hP.1
    have : P.LiesOver (Ideal.span {(p : ℤ)}) := hP.2
    exact Set.mem_singleton_iff.mpr
      (IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver' p K hζ P)
  · intro hP
    obtain rfl := Set.mem_singleton_iff.mp hP
    have : IsCyclotomicExtension {p ^ (0 + 1)} ℚ K := by simpa only [zero_add, pow_one]
    have hζp : IsPrimitiveRoot ζ (p ^ (0 + 1)) := by simpa only [zero_add, pow_one] using hζ
    exact ⟨inferInstance, by
      simpa only [zero_add, pow_one] using
        IsCyclotomicExtension.Rat.liesOver_span_zeta_sub_one p 0 hζp⟩

/-- The residue field at the cyclotomic prime is the field of `p` elements for odd prime `p`. -/
public noncomputable def quotientOneSubEquivZMod (hp2 : p ≠ 2) :
    (𝓞 K ⧸ Ideal.span {1 - hζ.toInteger}) ≃+* ZMod p := by
  have : Finite (𝓞 K ⧸ Ideal.span {1 - hζ.toInteger}) := by
    simpa only [hζ.span_one_sub_eq_span_zeta_sub_one] using
      hζ.finite_quotient_toInteger_sub_one hp.out.one_lt
  let _ := Fintype.ofFinite (𝓞 K ⧸ Ideal.span {1 - hζ.toInteger})
  refine (ZMod.ringEquivOfPrime (𝓞 K ⧸ Ideal.span {1 - hζ.toInteger}) hp.out ?_).symm
  rw [← Nat.card_eq_fintype_card, hζ.span_one_sub_eq_span_zeta_sub_one,
    hζ.card_quotient_toInteger_sub_one, hζ.norm_toInteger_sub_one_of_prime_ne_two' hp2,
    Int.natAbs_natCast]

/-- The integer norm of one minus the primitive root is `p` for odd prime `p`. -/
public theorem norm_toInteger_one_sub_of_prime_ne_two (hp2 : p ≠ 2) :
    Algebra.norm ℤ (1 - hζ.toInteger) = p := by
  have hn : Algebra.norm ℤ (-1 : 𝓞 K) = 1 := by
    rw [show (-1 : 𝓞 K) = algebraMap ℤ (𝓞 K) (-1) by simp,
      Algebra.norm_algebraMap, RingOfIntegers.rank, IsCyclotomicExtension.Rat.finrank p K,
      Nat.totient_prime hp.out, (hp.out.even_sub_one hp2).neg_pow, one_pow]
  rw [show 1 - hζ.toInteger = (-1 : 𝓞 K) * (hζ.toInteger - 1) by ring, map_mul, hn, one_mul,
    hζ.norm_toInteger_sub_one_of_prime_ne_two' hp2]

/-- The integral power basis of the primitive root has the prime cyclotomic discriminant. -/
public theorem integralPowerBasis_discr_prime :
    Algebra.discr ℤ hζ.integralPowerBasis.basis = (-1 : ℤ) ^ ((p - 1) / 2) * p ^ (p - 2) := by
  rw [NumberField.discr_eq_discr K hζ.integralPowerBasis.basis]
  exact IsCyclotomicExtension.Rat.discr_prime p K

end IsPrimitiveRoot
