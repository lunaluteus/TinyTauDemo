/-!
# Real units in prime cyclotomic fields

The fixed integral subring is generated by the sum of a primitive root and its inverse.
The quotient of a unit by its conjugate determines the unique root power in its decomposition.
Mathlib's `IsPrimitiveRoot.exists_pow_or_neg_mul_pow_of_isOfFinOrder` classifies the roots of unity.
See `/roadmap/index.qmd#prp-cyclotomic-units @ 9178eda5022b1704f5c50377a01fe80be473b96a`.
-/

public section

open scoped NumberField
open NumberField IsCMField

namespace TinyTauDemo

private theorem exists_add_mul_of_mem_adjoin_singleton {A : Type*} [CommRing A]
    {z t x : A} (hz : z ^ 2 = t * z - 1)
    (hx : x ∈ Algebra.adjoin ℤ ({z} : Set A)) :
    ∃ a ∈ Algebra.adjoin ℤ ({t} : Set A),
      ∃ b ∈ Algebra.adjoin ℤ ({t} : Set A), x = a + b * z := by
  let S := Algebra.adjoin ℤ ({t} : Set A)
  have ht : t ∈ S := Algebra.subset_adjoin (Set.mem_singleton _)
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact ⟨0, zero_mem S, 1, one_mem S, by simp⟩
  | algebraMap n =>
    exact ⟨_, S.algebraMap_mem n, 0, zero_mem S, by simp⟩
  | add y w _ _ hy hw =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hy
    obtain ⟨c, hc, d, hd, rfl⟩ := hw
    exact ⟨a + c, add_mem ha hc, b + d, add_mem hb hd, by ring⟩
  | mul y w _ _ hy hw =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hy
    obtain ⟨c, hc, d, hd, rfl⟩ := hw
    refine ⟨a * c - b * d, sub_mem (mul_mem ha hc) (mul_mem hb hd),
      a * d + b * c + b * d * t,
      add_mem (add_mem (mul_mem ha hd) (mul_mem hb hc)) (mul_mem (mul_mem hb hd) ht), ?_⟩
    calc
      _ = a * c + (a * d + b * c) * z + b * d * z ^ 2 := by ring
      _ = _ := by rw [hz]; ring

private theorem mem_adjoin_symmetric_unit_iff_fixed {A : Type*} [CommRing A] [IsDomain A]
    (σ : A ≃+* A) (z : Aˣ) (hσ : σ (z : A) = ↑z⁻¹)
    (hne : (z : A) ≠ ↑z⁻¹) (hgen : Algebra.adjoin ℤ ({(z : A)} : Set A) = ⊤)
    (x : A) :
    x ∈ Algebra.adjoin ℤ ({(z : A) + ↑z⁻¹} : Set A) ↔ σ x = x := by
  let t : A := (z : A) + ↑z⁻¹
  let S := Algebra.adjoin ℤ ({t} : Set A)
  have hinv : σ (↑z⁻¹ : A) = (z : A) := by
    have hinv' : (↑(Units.map σ.toMonoidHom z)⁻¹ : A) = (z : A) := by
      have hmap : Units.map σ.toMonoidHom z = z⁻¹ := Units.ext hσ
      rw [hmap, inv_inv]
    exact hinv'
  have ht : σ t = t := by
    dsimp only [t]
    rw [map_add, hσ, hinv, add_comm]
  have hfix (y : A) (hy : y ∈ S) : σ y = y := by
    induction hy using Algebra.adjoin_induction with
    | mem y hy => simpa only [Set.mem_singleton_iff.mp hy] using ht
    | algebraMap n => simp [algebraMap_int_eq]
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
  refine ⟨hfix x, fun hx => ?_⟩
  have hz : (z : A) ^ 2 = t * (z : A) - 1 := by
    dsimp only [t]
    rw [add_mul, z.inv_mul, add_sub_cancel_right, pow_two]
  have hmem : x ∈ Algebra.adjoin ℤ ({(z : A)} : Set A) := by rw [hgen]; exact Algebra.mem_top
  obtain ⟨a, ha, b, hb, heq⟩ := exists_add_mul_of_mem_adjoin_singleton hz hmem
  have hcomp : a + b * (z : A) = a + b * ↑z⁻¹ := by
    calc
      a + b * (z : A) = σ x := heq.symm.trans hx.symm
      _ = a + b * ↑z⁻¹ := by rw [heq, map_add, map_mul, hfix a ha, hfix b hb, hσ]
  have hbzero : b = 0 := by
    have hmul := add_left_cancel hcomp
    have : b * ((z : A) - ↑z⁻¹) = 0 := by rw [mul_sub, hmul, sub_self]
    exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hne)
  simpa only [heq, hbzero, zero_mul, add_zero] using ha

section Cyclotomic

variable {K : Type*} [Field K] [NumberField K] {p : ℕ} [Fact p.Prime]
    [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p)

private noncomputable def integerRootUnit : (𝓞 K)ˣ :=
  (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne p)).unit

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem integerRootUnit_val : (integerRootUnit hζ : 𝓞 K) = hζ.toInteger :=
  IsUnit.unit_spec _

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem integerRootUnit_coe : (integerRootUnit hζ : K) = ζ := by
  rw [← NumberField.Units.coe_coe, integerRootUnit_val]
  rfl

omit [NumberField K] [IsCyclotomicExtension {p} ℚ K] in
private theorem integerRootUnit_isPrimitiveRoot : IsPrimitiveRoot (integerRootUnit hζ) p :=
  hζ.toInteger_isPrimitiveRoot.isUnit_unit (NeZero.ne p)

/-- The integer subalgebra generated by `ζ + ζ⁻¹` in the cyclotomic integers. -/
noncomputable def realCyclotomicIntegers : Subalgebra ℤ (𝓞 K) :=
  Algebra.adjoin ℤ {hζ.toInteger + (↑(integerRootUnit hζ)⁻¹ : 𝓞 K)}

variable [IsCMField K]

omit [IsCyclotomicExtension {p} ℚ K] in
private theorem conjRoot :
    unitsComplexConj K (integerRootUnit hζ) = (integerRootUnit hζ)⁻¹ := by
  let η := integerRootUnit hζ
  have hη : η ∈ NumberField.Units.torsion K :=
    (CommGroup.mem_torsion _).2 ((integerRootUnit_isPrimitiveRoot hζ).isOfFinOrder (NeZero.ne p))
  exact unitsComplexConj_torsion K ⟨η, hη⟩

omit [IsCyclotomicExtension {p} ℚ K] in
private theorem conjRoot_val :
    ringOfIntegersComplexConj K (integerRootUnit hζ : 𝓞 K) =
      (↑(integerRootUnit hζ)⁻¹ : 𝓞 K) := by
  exact congrArg (_root_.Units.val : (𝓞 K)ˣ → 𝓞 K) (conjRoot hζ)

/-- The subalgebra generated by `ζ + ζ⁻¹` consists of the integers fixed by conjugation. -/
theorem mem_realCyclotomicIntegers_iff (hp : 2 < p) (x : 𝓞 K) :
    x ∈ realCyclotomicIntegers hζ ↔ ringOfIntegersComplexConj K x = x := by
  let η := integerRootUnit hζ
  have hne : (η : 𝓞 K) ≠ ↑η⁻¹ := by
    intro heq
    have hηsq : η ^ 2 = 1 := by
      apply _root_.Units.ext
      rw [_root_.Units.val_pow_eq_pow_val, pow_two, _root_.Units.val_one]
      exact (congrArg (fun a : 𝓞 K => a * (η : 𝓞 K)) heq).trans η.inv_mul
    exact (integerRootUnit_isPrimitiveRoot hζ).pow_ne_one_of_pos_of_lt (by decide) hp hηsq
  have hgen : Algebra.adjoin ℤ ({(η : 𝓞 K)} : Set (𝓞 K)) = ⊤ := by
    rw [integerRootUnit_val]
    exact IsCyclotomicExtension.Rat.adjoin_singleton_eq_top hζ
  have hcx : ringOfIntegersComplexConj K (η : 𝓞 K) = (↑η⁻¹ : 𝓞 K) := conjRoot_val hζ
  simpa only [realCyclotomicIntegers, η, integerRootUnit_val, AlgEquiv.coe_toRingEquiv] using
    mem_adjoin_symmetric_unit_iff_fixed (ringOfIntegersComplexConj K).toRingEquiv η hcx hne hgen x

private theorem quotientMap_conj (x : 𝓞 K) :
    let q := Ideal.Quotient.mk (Ideal.span {hζ.toInteger - 1})
    q (ringOfIntegersComplexConj K x) = q x := by
  let q := Ideal.Quotient.mk (Ideal.span {hζ.toInteger - 1})
  let σ := ringOfIntegersComplexConj K
  let η := integerRootUnit hζ
  have hqη : q (η : 𝓞 K) = 1 := by
    rw [integerRootUnit_val]
    exact (Ideal.Quotient.mk_eq_one_iff_sub_mem _).mpr (Ideal.mem_span_singleton_self _)
  have hqηinv : q (↑η⁻¹ : 𝓞 K) = 1 := by
    calc
      q (↑η⁻¹ : 𝓞 K) = q (↑η⁻¹ : 𝓞 K) * q (η : 𝓞 K) := by rw [hqη, mul_one]
      _ = 1 := by rw [← map_mul, η.inv_mul, map_one]
  have hgen : x ∈ Algebra.adjoin ℤ ({(η : 𝓞 K)} : Set (𝓞 K)) := by
    rw [integerRootUnit_val, IsCyclotomicExtension.Rat.adjoin_singleton_eq_top hζ]
    exact Algebra.mem_top
  suffices q (σ x) = q x from this
  induction hgen using Algebra.adjoin_induction with
  | mem y hmem =>
    rw [Set.mem_singleton_iff.mp hmem]
    exact ((congrArg q (conjRoot_val hζ)).trans hqηinv).trans hqη.symm
  | algebraMap n => simp [σ, algebraMap_int_eq]
  | add a b _ _ ha hb => rw [map_add, map_add, map_add, ha, hb]
  | mul a b _ _ ha hb => rw [map_mul, map_mul, map_mul, ha, hb]

private theorem exists_conjugationQuotient_eq_root_sq (hp : 2 < p) (u : (𝓞 K)ˣ) :
    ∃ r : Fin p, u * (unitsComplexConj K u)⁻¹ = (integerRootUnit hζ ^ (r : ℕ)) ^ 2 := by
  let η := integerRootUnit hζ
  let δ := unitsMulComplexConjInv K u
  have hδ : IsOfFinOrder (δ.val : K) := by
    have h : IsOfFinOrder δ.val := (CommGroup.mem_torsion _).1 δ.property
    exact (Function.Injective.isOfFinOrder_iff
      (f := (algebraMap (𝓞 K) K).toMonoidHom.comp (_root_.Units.coeHom (𝓞 K)))
      (NumberField.Units.coe_injective K)).2 h
  have hpodd : Odd p := (Fact.out : p.Prime).odd_of_ne_two (ne_of_gt hp)
  obtain ⟨r, hr, heq | heq⟩ := hζ.exists_pow_or_neg_mul_pow_of_isOfFinOrder hpodd hδ
  · have hroot : δ.val = η ^ r := by
      apply NumberField.Units.coe_injective
      simpa only [NumberField.Units.coe_pow, η, integerRootUnit_coe] using heq
    have hη := integerRootUnit_isPrimitiveRoot hζ
    obtain ⟨m, hm⟩ := hη.exists_pow_eq_pow_two_mul hpodd r
    let s : Fin p := ⟨m % p, Nat.mod_lt _ (NeZero.pos p)⟩
    refine ⟨s, ?_⟩
    have hmod : η ^ (s : ℕ) = η ^ m := by
      change η ^ (m % p) = η ^ m
      rw [hη.eq_orderOf, pow_mod_orderOf]
    change δ.val = (η ^ (s : ℕ)) ^ 2
    calc
      δ.val = η ^ r := hroot
      _ = η ^ (2 * m) := hm
      _ = (η ^ m) ^ 2 := by rw [Nat.mul_comm 2, pow_mul]
      _ = _ := by rw [hmod]
  · exfalso
    have hroot : δ.val = -η ^ r := by
      apply NumberField.Units.coe_injective
      simpa only [NumberField.Units.coe_pow, η, integerRootUnit_coe, _root_.Units.val_neg,
        NumberField.Units.coe_coe, map_neg] using heq
    let q := Ideal.Quotient.mk (Ideal.span {hζ.toInteger - 1})
    have hqη : q (η : 𝓞 K) = 1 := by
      rw [integerRootUnit_val]
      exact (Ideal.Quotient.mk_eq_one_iff_sub_mem _).mpr (Ideal.mem_span_singleton_self _)
    have hqconj : q (unitsComplexConj K u : 𝓞 K) = q (u : 𝓞 K) :=
      quotientMap_conj hζ (u : 𝓞 K)
    have hqδ : q (δ.val : 𝓞 K) = 1 := by
      let c := unitsComplexConj K u
      have hm : q (u : 𝓞 K) * q (↑c⁻¹ : 𝓞 K) = 1 := by
        rw [← hqconj, ← map_mul, c.mul_inv, map_one]
      rw [unitsMulComplexConjInv_apply, _root_.Units.val_mul, map_mul]
      exact hm
    have hneg : q (δ.val : 𝓞 K) = -1 := by
      rw [hroot, _root_.Units.val_neg, _root_.Units.val_pow_eq_pow_val,
        map_neg, map_pow, hqη, one_pow]
    have htwo : q (2 : 𝓞 K) = 0 := by
      have hone : (1 : 𝓞 K ⧸ Ideal.span {hζ.toInteger - 1}) = -1 := hqδ.symm.trans hneg
      rw [← one_add_one_eq_two, map_add, map_one, ← neg_eq_iff_add_eq_zero]
      exact hone.symm
    exact IsCyclotomicExtension.Rat.two_notMem_span_zeta_sub_one' p hζ hp
      (Ideal.Quotient.eq_zero_iff_mem.mp htwo)

private theorem map_realUnit_conj (hp : 2 < p) (w : (realCyclotomicIntegers hζ)ˣ) :
    unitsComplexConj K (_root_.Units.map (realCyclotomicIntegers hζ).val.toMonoidHom w) =
      _root_.Units.map (realCyclotomicIntegers hζ).val.toMonoidHom w := by
  apply _root_.Units.ext
  exact (mem_realCyclotomicIntegers_iff hζ hp _).mp
    (show ((w : realCyclotomicIntegers hζ) : 𝓞 K) ∈ realCyclotomicIntegers hζ from w.val.property)

private theorem exists_realUnit_of_fixed (hp : 2 < p) (u : (𝓞 K)ˣ)
    (hu : unitsComplexConj K u = u) :
    ∃ w : (realCyclotomicIntegers hζ)ˣ,
      _root_.Units.map (realCyclotomicIntegers hζ).val.toMonoidHom w = u := by
  have hmem : (u : 𝓞 K) ∈ realCyclotomicIntegers hζ :=
    (mem_realCyclotomicIntegers_iff hζ hp _).mpr
      (congrArg (_root_.Units.val : (𝓞 K)ˣ → 𝓞 K) hu)
  have hinv : unitsComplexConj K u⁻¹ = u⁻¹ := by rw [map_inv, hu]
  have hmeminv : (↑u⁻¹ : 𝓞 K) ∈ realCyclotomicIntegers hζ :=
    (mem_realCyclotomicIntegers_iff hζ hp _).mpr
      (congrArg (_root_.Units.val : (𝓞 K)ˣ → 𝓞 K) hinv)
  let w : (realCyclotomicIntegers hζ)ˣ :=
    ⟨⟨u, hmem⟩, ⟨↑u⁻¹, hmeminv⟩, Subtype.ext u.mul_inv, Subtype.ext u.inv_mul⟩
  exact ⟨w, _root_.Units.ext rfl⟩

private theorem existsUnique_root_mul_realUnit_aux (hp : 2 < p) (u : (𝓞 K)ˣ) :
    ∃! pair : Fin p × (realCyclotomicIntegers hζ)ˣ,
      u = integerRootUnit hζ ^ (pair.1 : ℕ) *
        _root_.Units.map (realCyclotomicIntegers hζ).val.toMonoidHom pair.2 := by
  let η := integerRootUnit hζ
  let c := unitsComplexConj K
  let lift := _root_.Units.map (realCyclotomicIntegers hζ).val.toMonoidHom
  obtain ⟨r, hr⟩ := exists_conjugationQuotient_eq_root_sq hζ hp u
  let v := (η ^ (r : ℕ))⁻¹ * u
  have hval : u = (η ^ (r : ℕ)) ^ 2 * c u := mul_inv_eq_iff_eq_mul.mp hr
  have hv : c v = v := by
    have hηconj : c η = η⁻¹ := conjRoot hζ
    calc
      c v = η ^ (r : ℕ) * c u := by
        dsimp only [v]
        rw [map_mul, map_inv, map_pow, hηconj, inv_pow, inv_inv]
      _ = (η ^ (r : ℕ))⁻¹ * ((η ^ (r : ℕ)) ^ 2 * c u) := by
        rw [pow_two, ← mul_assoc, ← mul_assoc, inv_mul_cancel, one_mul]
      _ = v := congrArg ((η ^ (r : ℕ))⁻¹ * ·) hval.symm
  obtain ⟨w, hw⟩ := exists_realUnit_of_fixed hζ hp v hv
  have hdecomp : u = η ^ (r : ℕ) * lift w := by
    rw [hw, ← mul_assoc, mul_inv_cancel, one_mul]
  refine ⟨⟨r, w⟩, hdecomp, ?_⟩
  rintro ⟨s, w'⟩ h'
  let q (y : (𝓞 K)ˣ) : (𝓞 K)ˣ := y * (c y)⁻¹
  have hq (i : Fin p) (a : (realCyclotomicIntegers hζ)ˣ) :
      q (η ^ (i : ℕ) * lift a) = (η ^ (i : ℕ)) ^ 2 := by
    have hηconj : c η = η⁻¹ := conjRoot hζ
    have haconj : c (lift a) = lift a := map_realUnit_conj hζ hp a
    dsimp only [q]
    rw [map_mul, map_pow, hηconj, inv_pow, haconj, mul_inv_rev, inv_inv, pow_two]
    simp only [mul_assoc, mul_inv_cancel_left]
  have heq := congrArg q (h'.symm.trans hdecomp)
  rw [hq, hq] at heq
  have hcop : (2 : ℕ).Coprime p := by
    apply Nat.Coprime.symm
    exact (Fact.out : p.Prime).coprime_iff_not_dvd.mpr
      (fun hd => (not_le_of_gt hp) (Nat.le_of_dvd (by decide) hd))
  have hηsq : IsPrimitiveRoot (η ^ 2) p :=
    (integerRootUnit_isPrimitiveRoot hζ).pow_of_coprime 2 hcop
  have hsr : s = r := Fin.ext (hηsq.pow_inj s.isLt r.isLt
    (by simpa only [← pow_mul, Nat.mul_comm 2] using heq))
  subst s
  have hwmap : lift w' = lift w := mul_left_cancel (h'.symm.trans hdecomp)
  have hww : w' = w := by
    apply _root_.Units.ext
    apply Subtype.ext
    exact congrArg (_root_.Units.val : (𝓞 K)ˣ → 𝓞 K) hwmap
  exact Prod.ext rfl hww

omit [IsCMField K] in
/-- In an odd prime cyclotomic field, each integer unit is a power of the primitive root times
a unit of the integer algebra generated by `ζ + ζ⁻¹`. The exponent and the real unit are
unique, with the exponent taken modulo the prime. -/
theorem existsUnique_root_mul_realUnit (hp : 2 < p) (u : (𝓞 K)ˣ) :
    ∃! pair : Fin p × (realCyclotomicIntegers hζ)ˣ,
      (u : 𝓞 K) = hζ.toInteger ^ (pair.1 : ℕ) * ((pair.2 : realCyclotomicIntegers hζ) : 𝓞 K) := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField (S := {p}) K ⟨p, rfl, hp⟩
  refine (existsUnique_congr (fun pair => ?_)).mp (existsUnique_root_mul_realUnit_aux hζ hp u)
  have hcoe :
      (_root_.Units.map (realCyclotomicIntegers hζ).val.toMonoidHom pair.2 : 𝓞 K) =
        ((pair.2 : realCyclotomicIntegers hζ) : 𝓞 K) := rfl
  constructor
  · intro h
    have hval := congrArg (_root_.Units.val : (𝓞 K)ˣ → 𝓞 K) h
    simpa only [_root_.Units.val_mul, _root_.Units.val_pow_eq_pow_val, integerRootUnit_val, hcoe]
      using hval
  · intro h
    apply _root_.Units.ext
    simpa only [_root_.Units.val_mul, _root_.Units.val_pow_eq_pow_val, integerRootUnit_val, hcoe]
      using h

end Cyclotomic

end TinyTauDemo
