/-!
# Conjugation invariance from uniformizer ideles

Away from a finite set of places, the relative Galois group is generated by Frobenius.
Evaluating a factored idele-class character on uniformizer ideles at conjugate primes gives
the same value if those ideles agree under the character over each base prime.

See `/roadmap/index.qmd#rem-bernoulli-regular` @ `e74e1464a9abce7e83e565c5ccdf1957b5935bc6`.
-/

public section

open NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
open TauCeti TauCeti.ClassFieldTheory
open scoped NumberField Pointwise IsMulCommutative AdicCompletionExtension

namespace TinyTauDemo

variable {K E M : Type} [Field K] [NumberField K] [Field E] [NumberField E]
  [Field M] [NumberField M] [Algebra K E] [Algebra E M] [Algebra K M]
  [IsScalarTower K E M] [Normal K E] [IsAbelianGalois E M]

omit [NumberField K] [Algebra K E] [Algebra K M] [IsScalarTower K E M] [Normal K E] in
private theorem ideleClassAbelianArtinMap_ofAdicCompletion_of_frobenius
    (Q : HeightOneSpectrum (𝓞 M)) (hw : Algebra.IsUnramifiedAt (𝓞 E) Q.asIdeal)
    {σ : M ≃ₐ[E] M} (hσ : IsArithFrobAt (𝓞 E) σ Q.asIdeal)
    {π : ((Q.under (𝓞 E)).adicCompletion E)ˣ}
    (hπ : IsUniformizer ((Q.under (𝓞 E)).adicCompletion E) π) :
    ideleClassAbelianArtinMap E M
      (IdeleGroup.ofAdicCompletion (𝓞 E) E (Q.under (𝓞 E)) π : IdeleClassGroup (𝓞 E) E) =
      σ := by
  apply Abelianization.equivOfComm.injective
  change Abelianization.of _ = Abelianization.of _
  rw [abelianization_of_ideleClassAbelianArtinMap, ideleClassArtinMap_mk,
    ideleArtinMap_ofAdicCompletion, finiteLocalArtinAt_uniformizer _ Q hw hσ hπ]

/-- When an idele-class character factors through relative Artin reciprocity, equality of its
values on uniformizer ideles over the same base place implies invariance under ambient
conjugation. Frobenius elements outside a finite set suffice. -/
theorem relativeCharacter_conjugation_invariant_in_tower_of_uniformizer_eq
    {A : Type*} [Monoid A] (φ : (M ≃ₐ[E] M) →* A)
    (χ : IdeleClassGroup (𝓞 E) E →* A)
    (hfac : ∀ c : IdeleClassGroup (𝓞 E) E,
      φ (ideleClassAbelianArtinMap E M c) = χ c)
    (S : Finset (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ Q : HeightOneSpectrum (𝓞 M), Q.under (𝓞 K) ∉ S →
      Algebra.IsUnramifiedAt (𝓞 E) Q.asIdeal)
    (hχ : ∀ (w w' : HeightOneSpectrum (𝓞 E)), w.under (𝓞 K) = w'.under (𝓞 K) →
      ∀ (π : (w.adicCompletion E)ˣ) (π' : (w'.adicCompletion E)ˣ),
      IsUniformizer (w.adicCompletion E) π → IsUniformizer (w'.adicCompletion E) π' →
        χ (IdeleGroup.ofAdicCompletion (𝓞 E) E w π : IdeleClassGroup (𝓞 E) E) =
        χ (IdeleGroup.ofAdicCompletion (𝓞 E) E w' π' : IdeleClassGroup (𝓞 E) E))
    (g : M ≃ₐ[K] M) (σ τ : M ≃ₐ[E] M)
    (hστ : τ.restrictScalars K = g * σ.restrictScalars K * g⁻¹) :
    φ τ = φ σ := by
  let θ := scalarTowerConjugate (E := E) g
  have hgen := closure_isArithFrobAt_eq_top_tower (K := K) (L := E) (M := M) S
  have heq : (φ.comp θ).eqLocus φ = ⊤ := by
    apply top_unique
    rw [← hgen, Subgroup.closure_le]
    rintro σ ⟨v, hv, Q, hσ⟩
    let w := Q.val.under (𝓞 E)
    let Q' := conjugateHeightOnePrime g Q.val
    let w' := Q'.under (𝓞 E)
    have hvQ : Q.val.under (𝓞 K) = v := by
      let : Q.val.asIdeal.LiesOver v.asIdeal := Q.2
      exact HeightOneSpectrum.ext (Ideal.LiesOver.over (P := Q.val.asIdeal) (p := v.asIdeal)).symm
    have hw := hS Q.val (hvQ.symm ▸ hv)
    have hw' : Algebra.IsUnramifiedAt (𝓞 E) Q'.asIdeal := by
      simpa only [Q', conjugateHeightOnePrime_asIdeal] using
        isUnramifiedAt_smul_of_normal_scalarTower g Q.val.asIdeal hw
    have hww : w.under (𝓞 K) = w'.under (𝓞 K) :=
      (conjugateHeightOnePrime_under_under (E := E) g Q.val).symm
    obtain ⟨π, hπ⟩ := exists_isUniformizer (w.adicCompletion E)
    obtain ⟨π', hπ'⟩ := exists_isUniformizer (w'.adicCompletion E)
    have hσ' : IsArithFrobAt (𝓞 E) (θ σ) Q'.asIdeal := by
      rw [conjugateHeightOnePrime_asIdeal]
      exact isArithFrobAt_scalarTowerConjugate hσ
    have hπσ := ideleClassAbelianArtinMap_ofAdicCompletion_of_frobenius Q.val hw hσ hπ
    have hπσ' := ideleClassAbelianArtinMap_ofAdicCompletion_of_frobenius Q' hw' hσ' hπ'
    change φ (θ σ) = φ σ
    rw [← hπσ', ← hπσ, hfac, hfac]
    exact (hχ w w' hww π π' hπ hπ').symm
  have hh : σ ∈ (φ.comp θ).eqLocus φ := by rw [heq]; trivial
  have ht : τ = θ σ := AlgEquiv.restrictScalars_injective K
    (hστ.trans (scalarTowerConjugate_restrictScalars g σ).symm)
  rw [ht]
  exact hh

omit [NumberField K] [Normal K E] in
/-- The contractions to the ground field of the intermediate primes ramified in the top extension
form a finite exceptional set for relative Frobenius. -/
theorem exists_finset_relativeUnramified_over_base :
    ∃ S : Finset (HeightOneSpectrum (𝓞 K)), ∀ Q : HeightOneSpectrum (𝓞 M),
      Q.under (𝓞 K) ∉ S → Algebra.IsUnramifiedAt (𝓞 E) Q.asIdeal := by
  classical
  refine ⟨(NumberField.Chebotarev.ramifiedPrimes E M).image (under (𝓞 K)), ?_⟩
  intro Q hQ
  apply (NumberField.Chebotarev.under_notMem_ramifiedPrimes_iff_isUnramifiedAt
    (K := E) Q).mp
  intro hbad
  apply hQ
  refine Finset.mem_image.mpr ⟨Q.under (𝓞 E), hbad, HeightOneSpectrum.ext ?_⟩
  exact Ideal.under_under (A := 𝓞 K) (B := 𝓞 E) Q.asIdeal

end TinyTauDemo
