/-!
# Unramified cyclic extensions from the ordinary class number

Pull back the class character through the extension generated by the relevant roots of unity.
Enlarge the finite set of Kummer places to lie over a set of places of the original field.
Frobenius on uniformizer ideles proves invariance of the realized character under conjugation.
Transfer gives the cyclic extension over the original field and descends unramifiedness.

See `/roadmap/index.qmd#rem-bernoulli-regular` @ `e74e1464a9abce7e83e565c5ccdf1957b5935bc6`.
-/

public section

open IsDedekindDomain NumberField IntermediateField TauCeti TauCeti.ClassFieldTheory
  TauCeti.GlobalNumberFields
open scoped NumberField IsMulCommutative

namespace TinyTauDemo

variable (K : Type) [Field K] [NumberField K]

/-- A prime dividing the class number is the degree of a cyclic extension
unramified at every finite prime. -/
theorem exists_unramified_cyclic_extension_of_dvd_classNumber {p : ℕ} (hp : p.Prime)
    (hdvd : p ∣ classNumber K) :
    ∃ (L : Type) (_ : Field L) (_ : NumberField L) (_ : Algebra K L),
      IsGalois K L ∧ IsCyclic (L ≃ₐ[K] L) ∧ Module.finrank K L = p ∧
      ∀ w : HeightOneSpectrum (𝓞 L), Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal := by
  let : Fact p.Prime := ⟨hp⟩
  obtain ⟨χ, hχ, _, hopen, hunit⟩ := exists_ideleClass_prime_quotient_of_dvd_classNumber K hp hdvd
  obtain ⟨E, hEField, hEGal, ⟨hEμ⟩, hcop⟩ := exists_cyclotomic_intermediateField_of_prime K hp
  let : NumberField E := hEField
  let : IsGalois K E := hEGal
  let : HasEnoughRootsOfUnity E p := hEμ
  let Ω := SeparableClosure K
  let χE := χ.comp (ideleClassNormMap K E).toMonoidHom
  obtain ⟨hχE, _, hopenE⟩ :=
    ideleClassCharacter_comp_norm_open_of_coprime (E := E) χ hχ hopen hcop.symm
  have hExp (g : Multiplicative (ZMod p)) : g ^ p = 1 := by
    change p • g.toAdd = 0
    exact ZModModule.char_nsmul_eq_zero p g.toAdd
  obtain ⟨S, hcl, hpS, hS⟩ := exists_kummerIdeleClassSubgroup_le_ker_of_isOpen χE hExp hopenE
  obtain ⟨T, S', hSS', hS'⟩ := exists_finset_primesAbove_superset E S
  have hcl' : Subgroup.closure
      (HeightOneSpectrum.classGroupMk '' (S' : Set (HeightOneSpectrum (𝓞 E)))) = ⊤ :=
    eq_top_mono (Subgroup.closure_mono (Set.image_mono hSS')) hcl
  let M := kummerField Ω p ((S' : Set (HeightOneSpectrum (𝓞 E))).unit E)
  have : NumberField M := inferInstance
  have : IsAbelianGalois E M := inferInstance
  have : IsGalois K M := isGalois_kummerField_sUnits_of_coe_eq_primesAbove E p T S' hS'
  obtain ⟨φ, hφ, hsur, hGal, _hCyc, hdeg, hNorm⟩ :=
    exists_cyclic_norm_realization_at_good_S (Ω := Ω) χE hχE (Nat.card_zmod p) S' hcl'
      (fun v hv ↦ hSS' (hpS v hv)) (hS S' hSS')
  let F : IntermediateField E M := fixedField φ.ker
  let : Algebra E F := F.algebra
  let : Module E F := Algebra.toModule
  let : IsGalois E F := hGal
  have : NumberField F := NumberField.of_module_finite E F
  have : IsAbelianGalois E F := IsAbelianGalois.of_algHom F.val
  have hpdeg : (Module.finrank E F).Prime := hdeg.symm ▸ hp
  have hunr (w : HeightOneSpectrum (𝓞 F)) : Algebra.IsUnramifiedAt (𝓞 E) w.asIdeal :=
    isUnramifiedAt_of_ideleClassCharacter_ker_eq E F χE
      (ideleClassCharacter_comp_norm_kills_finite_integralUnits χ hunit)
      ((ker_ideleClassAbelianArtinMap_eq_of_prime_degree E F hpdeg).trans hNorm) w
  obtain ⟨B, hB⟩ := exists_finset_relativeUnramified_over_base (K := K) (E := E) (M := M)
  have hconj := relativeCharacter_conjugation_invariant_in_tower_of_uniformizer_eq
    (K := K) (E := E) (M := M) φ χE (DFunLike.congr_fun hφ) B hB
    (fun _ _ h _ _ hπ hπ' ↦ character_norm_ofAdicCompletion_uniformizer_eq χ hunit h hπ hπ')
  obtain ⟨L, hLGal, hLCyc, hLdeg, hLunr, _⟩ :=
    exists_unramified_cyclic_descent_of_relative_character (K := K) (E := E) (M := M)
      hp φ hsur hcop hconj hunr
  let : IsGalois K L := hLGal
  have : NumberField L := NumberField.of_module_finite K L
  exact ⟨L, inferInstance, inferInstance, inferInstance, hLGal, hLCyc, hLdeg, hLunr⟩

end TinyTauDemo
