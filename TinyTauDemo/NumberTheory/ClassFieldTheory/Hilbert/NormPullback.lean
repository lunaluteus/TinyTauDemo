module

public import TauCeti.NumberTheory.NumberField.Global.Ideles.Norm.Relative
public import Mathlib.NumberTheory.Cyclotomic.Basic
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots

/-!
# Pullback of prime-order idele class characters

A character of prime order stays surjective under norm pullback through an
extension of coprime degree. The pullback preserves openness of the kernel
and vanishing on ideles integral as units at each finite place.

See `/roadmap/index.qmd#rem-bernoulli-regular` @ `e74e1464a9abce7e83e565c5ccdf1957b5935bc6`.
-/

public section

open NumberField IsDedekindDomain TauCeti.GlobalNumberFields

namespace TinyTauDemo

private theorem card_multiplicative_zmod (p : ℕ) : Nat.card (Multiplicative (ZMod p)) = p :=
  Nat.card_zmod p

section Norms

variable {K E : Type*} [Field K] [NumberField K] [Field E] [NumberField E] [Algebra K E]

/-- The norm of an idele integral as a unit at all finite places has the same property. -/
private theorem ideleNormMap_mem_finite_integralUnits (x : IdeleGroup (𝓞 E) E)
    (hx : IdeleGroup.toFiniteIdele (𝓞 E) E x ∈ FiniteAdeleRing.integralUnits (𝓞 E) E) :
    IdeleGroup.toFiniteIdele (𝓞 K) K (ideleNormMap K E x) ∈
      FiniteAdeleRing.integralUnits (𝓞 K) K := by
  rw [FiniteAdeleRing.mem_integralUnits_iff_forall_mem_adicCompletionIntegers] at hx ⊢
  simp only [IdeleGroup.coe_toFiniteIdele, ← map_inv (IdeleGroup.toFiniteIdele (𝓞 E) E)] at hx
  intro v
  constructor
  · simp only [IdeleGroup.coe_toFiniteIdele, coe_ideleNormMap, adeleNorm_snd]
    rw [finiteAdeleNorm_apply]
    exact finprod_norm_mem_adicCompletionIntegers K E _ v fun w _ ↦ (hx w).1
  · rw [← map_inv (IdeleGroup.toFiniteIdele (𝓞 K) K), ← map_inv (ideleNormMap K E)]
    simp only [IdeleGroup.coe_toFiniteIdele, coe_ideleNormMap, adeleNorm_snd]
    rw [finiteAdeleNorm_apply]
    exact finprod_norm_mem_adicCompletionIntegers K E _ v fun w _ ↦ (hx w).2

/-- A surjective character of prime order remains surjective when pulled back by
the idele class norm along an extension of coprime degree. -/
private theorem surjective_ideleClassCharacter_comp_norm_of_coprime {p : ℕ}
    (χ : IdeleClassGroup (𝓞 K) K →* Multiplicative (ZMod p)) (hχ : Function.Surjective χ)
    (hcop : (Module.finrank K E).Coprime p) :
    Function.Surjective (χ.comp (ideleClassNormMap K E).toMonoidHom) := by
  intro t
  obtain ⟨u, hu⟩ := (powCoprime (G := Multiplicative (ZMod p))
    ((card_multiplicative_zmod p).symm ▸ hcop.symm)).surjective t
  obtain ⟨c, hc⟩ := hχ u
  refine ⟨ideleClassExtension K E c, ?_⟩
  change χ (ideleClassNormMap K E (ideleClassExtension K E c)) = t
  rw [ideleClassNormMap_ideleClassExtension, map_pow, hc]
  exact hu

/-- The pullback of an open prime-index character along a norm of coprime degree
has an open kernel of the same index. -/
theorem ideleClassCharacter_comp_norm_open_of_coprime {p : ℕ}
    (χ : IdeleClassGroup (𝓞 K) K →* Multiplicative (ZMod p)) (hχ : Function.Surjective χ)
    (hopen : IsOpen (χ.ker : Set (IdeleClassGroup (𝓞 K) K)))
    (hcop : (Module.finrank K E).Coprime p) :
    let ψ := χ.comp (ideleClassNormMap K E).toMonoidHom
    Function.Surjective ψ ∧ ψ.ker.index = p ∧
      IsOpen (ψ.ker : Set (IdeleClassGroup (𝓞 E) E)) := by
  let ψ := χ.comp (ideleClassNormMap K E).toMonoidHom
  have hψ : Function.Surjective ψ := surjective_ideleClassCharacter_comp_norm_of_coprime χ hχ hcop
  refine ⟨hψ, ?_, ?_⟩
  · rw [Subgroup.index_ker, ψ.range_eq_top_of_surjective hψ, Subgroup.card_top]
    exact card_multiplicative_zmod p
  · exact hopen.preimage (continuous_ideleClassNormMap K E)

/-- Pulling back a class character that kills all finite integral units gives a
character with the same property over the extension field. -/
theorem ideleClassCharacter_comp_norm_kills_finite_integralUnits {p : ℕ}
    (χ : IdeleClassGroup (𝓞 K) K →* Multiplicative (ZMod p))
    (hχ : ∀ x : IdeleGroup (𝓞 K) K,
      IdeleGroup.toFiniteIdele (𝓞 K) K x ∈ FiniteAdeleRing.integralUnits (𝓞 K) K → χ x = 1)
    (x : IdeleGroup (𝓞 E) E)
    (hx : IdeleGroup.toFiniteIdele (𝓞 E) E x ∈ FiniteAdeleRing.integralUnits (𝓞 E) E) :
    (χ.comp (ideleClassNormMap K E).toMonoidHom) (x : IdeleClassGroup (𝓞 E) E) = 1 := by
  change χ (ideleClassNormMap K E (x : IdeleClassGroup (𝓞 E) E)) = 1
  rw [ideleClassNormMap_mk]
  exact hχ _ (ideleNormMap_mem_finite_integralUnits x hx)

/-- An extension generated by a primitive p-th root has degree prime to p. -/
theorem coprime_finrank_of_prime_cyclotomic {p : ℕ} [NeZero p]
    [IsCyclotomicExtension {p} K E] (hp : p.Prime) : (Module.finrank K E).Coprime p := by
  let ζ := IsCyclotomicExtension.zeta p K E
  have hζ := IsCyclotomicExtension.zeta_spec p K E
  have hd : Module.finrank K E ≤ p - 1 := calc
    _ = (minpoly K ζ).natDegree := by
      rw [(hζ.powerBasis K).finrank, IsPrimitiveRoot.powerBasis_dim]
    _ ≤ (Polynomial.cyclotomic p K).natDegree := Polynomial.natDegree_le_of_dvd
      (minpoly.dvd K ζ (IsCyclotomicExtension.aeval_zeta p K E))
      (Polynomial.cyclotomic_ne_zero p K)
    _ = p - 1 := by rw [Polynomial.natDegree_cyclotomic, Nat.totient_prime hp]
  exact (hp.coprime_iff_not_dvd.mpr
    (Nat.not_dvd_of_pos_of_lt Module.finrank_pos
      (lt_of_le_of_lt hd (Nat.sub_lt hp.pos (by decide))))).symm

end Norms


end TinyTauDemo
