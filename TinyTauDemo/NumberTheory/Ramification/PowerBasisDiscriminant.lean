module

public import Mathlib.RingTheory.Discriminant
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
import Mathlib.RingTheory.Polynomial.Tower

/-!
# The discriminant of an integral power basis

Mathlib's embeddings formula `Algebra.discr_powerBasis_eq_prod` writes this discriminant as
a product of squared conjugate differences. The formulas below also express it as a determinant
of traces of powers and as a signed norm of the derivative of the integral minimal polynomial.
See `/roadmap/index.qmd#rem-ramification-disc-recall @ ac966279dffb3868e9777cbeb736cfbe55a73f63`.
-/

public section

namespace Algebra

/-- The trace pairing on the power basis has entries given by traces of powers. -/
theorem discr_powerBasis_eq_det_trace_pow {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] (pb : PowerBasis A B) :
    discr A pb.basis =
      (Matrix.of fun i j : Fin pb.dim => trace A B (pb.gen ^ (i + j : ℕ))).det := by
  rw [discr_def]
  congr 1
  ext i j
  simp only [traceMatrix_apply, traceForm_apply, PowerBasis.basis_eq_pow,
    Matrix.of_apply, pow_add]

/-- For a power basis generated by an element integral over the base domain, the signed-norm
formula can be computed using its minimal polynomial over that domain. -/
theorem discr_powerBasis_eq_norm_of_isIntegral {A F K : Type*}
    [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Field F] [Field K]
    [Algebra A F] [IsFractionRing A F] [Algebra F K] [Algebra A K] [IsScalarTower A F K]
    [Algebra.IsSeparable F K] (pb : PowerBasis F K) (hθ : IsIntegral A pb.gen) :
    discr F pb.basis =
      (-1) ^ (Module.finrank F K * (Module.finrank F K - 1) / 2) *
        norm F (Polynomial.aeval pb.gen (minpoly A pb.gen).derivative) := by
  have := pb.finite
  rw [discr_powerBasis_eq_norm, minpoly.isIntegrallyClosed_eq_field_fractions' F hθ,
    Polynomial.derivative_map, Polynomial.aeval_map_algebraMap]

end Algebra
