module

public import Mathlib.RingTheory.Coprime.Basic
public import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic.Ring

/-!
# Ideals generated by linear factors

When the underlying pair is coprime, the ideal of two linear forms contains the
difference of their coefficients. This controls common factors in cyclotomic factorizations.
-/

public section

namespace TinyTauDemo

/-- For coprime coordinates `x, y`, the ideal generated by two linear factors contains
the difference of their coefficients. -/
theorem span_sub_le_span_linear_factors {R : Type*} [CommRing R] {x y : R}
    (hxy : IsCoprime x y) (a b : R) :
    Ideal.span ({a - b} : Set R) ≤ Ideal.span {x + a * y, x + b * y} := by
  let I : Ideal R := Ideal.span {x + a * y, x + b * y}
  refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
  have ha : x + a * y ∈ I := Ideal.subset_span (Set.mem_insert _ _)
  have hb : x + b * y ∈ I := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hy : (a - b) * y ∈ I := by
    convert I.sub_mem ha hb using 1
    ring
  have hx : (a - b) * x ∈ I := by
    convert I.sub_mem (I.mul_mem_left a hb) (I.mul_mem_left b ha) using 1
    ring
  obtain ⟨r, s, hrs⟩ := hxy
  have hid : a - b = r * ((a - b) * x) + s * ((a - b) * y) := by
    calc
      a - b = (a - b) * 1 := (mul_one _).symm
      _ = _ := by rw [← hrs]; ring
  rw [hid]
  exact I.add_mem (I.mul_mem_left r hx) (I.mul_mem_left s hy)

end TinyTauDemo
