module

public import TinyTauDemo.CyclotomicLocalFactors
public import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal
public import Mathlib.NumberTheory.EulerProduct.DirichletLSeries

/-!
# Rational-prime Euler factors in prime cyclotomic fields

Each rational-prime factor of the Dedekind zeta function groups the primes
over that prime. Away from the conductor, the inertia degree gives the
matching product over all Dirichlet characters.

See `/roadmap/index.qmd#rem-bernoulli-regular` @ `19d05f674280fce4d59c513fd4da7aafdc84ca61`.
-/

public section

open NumberField Ideal
open scoped BigOperators NumberField

namespace TinyTauDemo

/-- The nonzero ideal of `ℤ` generated by a rational prime. -/
@[expose] def rationalPrimeIdeal (q : Nat.Primes) : Ideal ℤ := Ideal.span {((q : ℕ) : ℤ)}

theorem rationalPrimeIdeal_ne_bot (q : Nat.Primes) : rationalPrimeIdeal q ≠ ⊥ := by
  simpa [rationalPrimeIdeal] using q.property.ne_zero

instance (q : Nat.Primes) : (rationalPrimeIdeal q).IsMaximal :=
  ((Ideal.span_singleton_prime (by exact_mod_cast q.property.ne_zero)).mpr
    (Nat.prime_iff_prime_int.mp q.property)).isMaximal (rationalPrimeIdeal_ne_bot q)

theorem rationalPrimeIdeal_absNorm (q : Nat.Primes) :
    (rationalPrimeIdeal q).absNorm = (q : ℕ) := by
  simp [rationalPrimeIdeal, Algebra.norm_self]

/-- The corresponding Dedekind-zeta factors indexed by the primes above one rational prime. -/
@[expose] noncomputable def dedekindLocalFactor (K : Type*) [Field K] [NumberField K]
    (q : Nat.Primes) (s : ℂ) : ℂ :=
  ∏ Q : (rationalPrimeIdeal q).primesOver (𝓞 K), (1 - (Q.1.absNorm : ℂ) ^ (-s))⁻¹

variable (K : Type*) [Field K] [NumberField K]

/-- The local factor of a Galois number field in terms of its common inertia degree
and the number of primes above the given rational prime. -/
theorem dedekindLocalFactor_eq_of_isGalois [IsGalois ℚ K] (q : Nat.Primes) (s : ℂ) :
    dedekindLocalFactor K q s =
      ((1 - ((q : ℂ) ^ (-s)) ^ ((rationalPrimeIdeal q).inertiaDegIn (𝓞 K))) ^
        ((rationalPrimeIdeal q).primesOver (𝓞 K)).ncard)⁻¹ := by
  have hnorm (Q : (rationalPrimeIdeal q).primesOver (𝓞 K)) :
      Q.1.absNorm = (q : ℕ) ^ (rationalPrimeIdeal q).inertiaDegIn (𝓞 K) := by
    rw [← Ideal.absNorm_pow_inertiaDeg (rationalPrimeIdeal q) Q.1, rationalPrimeIdeal_absNorm,
      Ideal.inertiaDegIn_eq_inertiaDeg (rationalPrimeIdeal q) Q.1 Gal(K/ℚ)]
  rw [dedekindLocalFactor]
  simp only [hnorm, Nat.cast_pow, ← Complex.natCast_cpow_natCast_mul,
    Complex.cpow_nat_mul, Finset.prod_const, Finset.card_univ, inv_pow,
    Set.fintypeCard_eq_ncard]

variable {p : ℕ} [hp : Fact p.Prime] [IsCyclotomicExtension {p} ℚ K]

/-- The Euler factor at a rational prime away from the cyclotomic conductor equals
the product of all the Dirichlet factors at that prime. -/
theorem cyclotomic_dedekindLocalFactor_eq_prod_dirichletCharacter
    (q : Nat.Primes) (hne : (q : ℕ) ≠ p) (s : ℂ) :
    dedekindLocalFactor K q s =
      ∏ᶠ χ : DirichletCharacter ℂ p, (1 - χ (q : ℕ) * (q : ℂ) ^ (-s))⁻¹ := by
  have : IsGalois ℚ K := IsCyclotomicExtension.isGalois {p} ℚ K
  let qv : ℕ := q
  let : Fact qv.Prime := ⟨q.property⟩
  have hndvd : ¬ qv ∣ p := by
    intro h
    exact hne (((Nat.dvd_prime hp.out).mp h).resolve_left q.property.ne_one)
  let hcop : qv.Coprime p := q.property.coprime_iff_not_dvd.mpr hndvd
  let u := ZMod.unitOfCoprime qv hcop
  have hu : (u : ZMod p) = (qv : ZMod p) := ZMod.coe_unitOfCoprime qv hcop
  have he := IsCyclotomicExtension.Rat.ramificationIdxIn_eq_of_not_dvd qv K hndvd
  have hf := IsCyclotomicExtension.Rat.inertiaDegIn_eq_of_not_dvd qv K hndvd
  change (rationalPrimeIdeal q).ramificationIdxIn (𝓞 K) = 1 at he
  change (rationalPrimeIdeal q).inertiaDegIn (𝓞 K) = orderOf (qv : ZMod p) at hf
  rw [← hu, orderOf_units] at hf
  have hcard := Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn
    (rationalPrimeIdeal q) (𝓞 K) Gal(K/ℚ)
  rw [he, hf, one_mul, IsGalois.card_aut_eq_finrank,
    IsCyclotomicExtension.Rat.finrank p K] at hcard
  have hcard' : ((rationalPrimeIdeal q).primesOver (𝓞 K)).ncard = p.totient / orderOf u := by
    rw [← hcard, Nat.mul_div_cancel _ (orderOf_pos u)]
  rw [dedekindLocalFactor_eq_of_isGalois K, hf, hcard']
  rw [← prod_dirichletCharacter_localEulerFactor u]
  simp only [hu, qv]

end TinyTauDemo
