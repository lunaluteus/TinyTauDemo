module

public import TinyTauDemo.Fermat.Curve.FermatAffineSmooth
public import Mathlib.AlgebraicGeometry.Scheme
import Mathlib.Algebra.Ring.GeomSum
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# Local parameters at the affine branch points

At a rational point with coordinates `(a, 0)` and `a^n = 1`, the second
affine coordinate generates the maximal ideal. The difference `x - a` is
a unit times its `n`th power.

See `/roadmap/index.qmd#prp-fermat-genus` @ `b2c9a29565e4747906e07cca00173aa6354b72f0`.
-/

public section

open AlgebraicGeometry MvPolynomial IsLocalRing

namespace TinyTauDemo

universe u

variable {k : Type u} [Field k] {n : ℕ}

local notation "A" => FermatAffineRing k n 2
local notation "q" => (Ideal.Quotient.mkₐ k _ : MvPolynomial (Fin 2) k →ₐ[k] A)
local notation "x" => q (X 0)
local notation "y" => q (X 1)

private theorem coordinate_relation : x ^ n + y ^ n = 1 := by
  have hq : q (fermatAffineEquation k n 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have he := congrArg (q : MvPolynomial (Fin 2) k → A) (fermatAffineEquation_last (k := k) (n := n))
  rw [hq, map_sub, map_add, map_pow, map_pow, map_one] at he
  exact sub_eq_zero.mp he.symm

/-- The rational point ideal is generated by the differences of the two coordinates. -/
theorem ker_fermatLastChartEval {a b : k} (h : a ^ n + b ^ n = 1) :
    RingHom.ker (fermatLastChartEval h).toRingHom =
      Ideal.span {x - algebraMap k A a, y - algebraMap k A b} := by
  let f := fermatLastChartEval h
  let I : Ideal A := Ideal.span {x - algebraMap k A a, y - algebraMap k A b}
  have hx : Ideal.Quotient.mk I x = algebraMap k (A ⧸ I) a := by
    calc
      Ideal.Quotient.mk I x = Ideal.Quotient.mk I (algebraMap k A a) :=
        Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_insert _ _))
      _ = algebraMap k (A ⧸ I) a := (Ideal.Quotient.mkₐ k I).commutes a
  have hy : Ideal.Quotient.mk I y = algebraMap k (A ⧸ I) b := by
    calc
      Ideal.Quotient.mk I y = Ideal.Quotient.mk I (algebraMap k A b) :=
        Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      _ = algebraMap k (A ⧸ I) b := (Ideal.Quotient.mkₐ k I).commutes b
  have hcomp : (Ideal.Quotient.mkₐ k I).comp q = (Algebra.ofId k (A ⧸ I)).comp (f.comp q) := by
    ext i
    fin_cases i
    · change Ideal.Quotient.mk I x = algebraMap k (A ⧸ I) (fermatLastChartEval h (q (X 0)))
      rw [fermatLastChartEval_mk, aeval_X, Matrix.cons_val_zero]
      exact hx
    · change Ideal.Quotient.mk I y = algebraMap k (A ⧸ I) (fermatLastChartEval h (q (X 1)))
      rw [fermatLastChartEval_mk, aeval_X, Matrix.cons_val_one]
      exact hy
  apply le_antisymm
  · intro z hz
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k _ z
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have he := DFunLike.congr_fun hcomp p
    change Ideal.Quotient.mk I (q p) = algebraMap k (A ⧸ I) (f (q p)) at he
    rw [he, show f (q p) = 0 from hz, map_zero]
  · refine Ideal.span_le.mpr ?_
    rintro _ (rfl | hb)
    · change f (x - algebraMap k A a) = 0
      simp only [map_sub, f, fermatLastChartEval_mk, aeval_X, Matrix.cons_val_zero,
        AlgHom.commutes, Algebra.algebraMap_self_apply, sub_self]
    · obtain rfl := Set.mem_singleton_iff.mp hb
      change f (y - algebraMap k A b) = 0
      simp only [map_sub, f, fermatLastChartEval_mk, aeval_X, Matrix.cons_val_one,
        Matrix.cons_val_zero, AlgHom.commutes, Algebra.algebraMap_self_apply, sub_self]

/-- The point of the last Fermat chart with coordinates `(a,b)`. -/
noncomputable def fermatLastChartPoint {a b : k} (h : a ^ n + b ^ n = 1) :
    PrimeSpectrum A :=
  ⟨RingHom.ker (fermatLastChartEval h).toRingHom, RingHom.ker_isPrime _⟩

@[simp] theorem fermatLastChartPoint_asIdeal {a b : k} (h : a ^ n + b ^ n = 1) :
    (fermatLastChartPoint h).asIdeal = RingHom.ker (fermatLastChartEval h).toRingHom := by
  unfold fermatLastChartPoint
  rfl

/-- The maximal ideal at an affine branch point is generated by `y`, and the
base coordinate `x - a` is a unit times `y^n`. -/
theorem fermatLastChart_branch_local_parameters [CharZero k] (hn : 0 < n)
    {a : k} (ha : a ^ n = 1) :
    let h : a ^ n + (0 : k) ^ n = 1 := by simpa [zero_pow hn.ne'] using ha
    let p := fermatLastChartPoint h
    haveI : p.asIdeal.IsPrime := p.isPrime
    let L := Localization.AtPrime p.asIdeal
    let j := algebraMap A L
    IsLocalRing.maximalIdeal L = Ideal.span {j y} ∧ ∃ u : Lˣ,
      j (x - algebraMap k A a) = (u : L) * (j y) ^ n := by
  dsimp only
  let h : a ^ n + (0 : k) ^ n = 1 := by simpa [zero_pow hn.ne'] using ha
  let f := fermatLastChartEval h
  let p := fermatLastChartPoint h
  have : p.asIdeal.IsPrime := p.isPrime
  let L := Localization.AtPrime p.asIdeal
  let j := algebraMap A L
  let a₀ := algebraMap k A a
  let s : A := ∑ i ∈ Finset.range n, x ^ i * a₀ ^ (n - 1 - i)
  have hs : (x - a₀) * s = -y ^ n := by
    rw [show (x - a₀) * s = x ^ n - a₀ ^ n from (Commute.all x a₀).mul_geom_sum₂ n,
      show a₀ ^ n = 1 by rw [← map_pow, ha, map_one]]
    linear_combination coordinate_relation (k := k) (n := n)
  have hf : f s = (n : k) * a ^ (n - 1) := by
    simp only [s, map_sum, map_mul, map_pow, a₀, f, fermatLastChartEval_mk, aeval_X,
      Matrix.cons_val_zero, AlgHom.commutes, Algebra.algebraMap_self_apply, geom_sum₂_self]
  have ha₀ : a ≠ 0 := by
    intro hzero
    rw [hzero, zero_pow hn.ne'] at ha
    exact zero_ne_one ha
  have hu : IsUnit (j s) := by
    apply (IsLocalization.AtPrime.isUnit_to_map_iff L p.asIdeal s).2
    rw [Ideal.mem_primeCompl_iff, fermatLastChartPoint_asIdeal, RingHom.mem_ker]
    change f s ≠ 0
    rw [hf]
    exact mul_ne_zero (Nat.cast_ne_zero.mpr hn.ne') (pow_ne_zero _ ha₀)
  have hmap : j (x - a₀) = (↑((-hu.unit⁻¹) : Lˣ) : L) * (j y) ^ n := by
    have he := congrArg j hs
    rw [map_mul, map_neg, map_pow, ← hu.unit_spec] at he
    rw [Units.val_neg, neg_mul, mul_comm (↑hu.unit⁻¹ : L), ← neg_mul, ← he, mul_assoc,
      Units.mul_inv, mul_one]
  change IsLocalRing.maximalIdeal L = Ideal.span {j y} ∧ ∃ u : Lˣ, _
  refine ⟨?_, ⟨-hu.unit⁻¹, hmap⟩⟩
  have hp : p.asIdeal = Ideal.span {x - a₀, y} := by
    rw [show p.asIdeal = RingHom.ker f.toRingHom from fermatLastChartPoint_asIdeal h,
      ker_fermatLastChartEval h, map_zero, sub_zero]
  calc
    IsLocalRing.maximalIdeal L = p.asIdeal.map j :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal L).symm
    _ = (Ideal.span {x - a₀, y}).map j := congrArg (fun I : Ideal A ↦ I.map j) hp
    _ = Ideal.span {j y} := by
      rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
      apply le_antisymm
      · refine Ideal.span_le.mpr ?_
        rintro _ (rfl | hmem)
        · rw [hmap]
          exact Ideal.mem_span_singleton.mpr ((dvd_pow_self _ hn.ne').trans (dvd_mul_left _ _))
        · exact Ideal.subset_span hmem
      · exact Ideal.span_mono (Set.singleton_subset_iff.mpr
          (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

end TinyTauDemo
