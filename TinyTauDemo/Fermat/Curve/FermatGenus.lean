import TinyTauDemo.Fermat.Curve.FermatEquation

/-!
# The genus of the Fermat function field

Tau Ceti's genus theorem for homogeneous plane equations applies to the Fermat polynomial
because its partial derivatives have no common nonzero zero.
See `/roadmap/index.qmd#prp-fermat-genus @ 043043ffcec6f4232273321a224bc7d77c9ec441`.
-/

namespace TinyTauDemo

open MvPolynomial
open scoped IntermediateField

variable {k F : Type*} [Field k] [CharZero k] [Field F] [Algebra k F]

private theorem fermatEquation_nonsingular {n : ℕ} (hn : 0 < n)
    (p : Fin 3 → AlgebraicClosure k) (hp : p ≠ 0) (_ : aeval p (fermatEquation k n) = 0) :
    ∃ i, aeval p (pderiv i (fermatEquation k n)) ≠ 0 :=
  fermatEquation_exists_aeval_pderiv_ne_zero hn p hp

/-- The function field generated by the affine Fermat coordinates has exact constant field `k`. -/
public theorem isIntegrallyClosedIn_of_fermatEquation {n : ℕ} (hn : 0 < n) {x y : F}
    (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤) (h : x ^ n + y ^ n = 1) :
    IsIntegrallyClosedIn k F :=
  TauCeti.isIntegrallyClosedIn_of_isHomogeneous (fermatEquation_isHomogeneous k n)
    (fermatEquation_nonsingular hn) hx hgen ((aeval_fermatEquation_eq_zero_iff n x y).mpr h)

/-- The function field generated by the affine Fermat coordinates has genus
`(n - 1) * (n - 2) / 2`. -/
public theorem genus_eq_of_fermatEquation {n : ℕ} (hn : 0 < n) {x y : F}
    (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤) (h : x ^ n + y ^ n = 1) :
    TauCeti.genus k F = (n - 1) * (n - 2) / 2 :=
  TauCeti.genus_eq_of_isHomogeneous (fermatEquation_isHomogeneous k n)
    (fermatEquation_nonsingular hn) hx hgen ((aeval_fermatEquation_eq_zero_iff n x y).mpr h)

end TinyTauDemo
