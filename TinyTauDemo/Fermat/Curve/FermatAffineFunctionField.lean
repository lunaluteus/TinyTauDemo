module

public import TinyTauDemo.Fermat.Curve.FermatAffineSmooth
public import TinyTauDemo.Fermat.Curve.FermatGenus
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Function field of an affine Fermat chart

See `/roadmap/index.qmd#prp-fermat-genus` @ `fbc988a5bcd0d78cdb5b294d62d21b7c0f620a09`.
-/

public section

open MvPolynomial IntermediateField
open scoped IntermediateField

namespace TinyTauDemo

variable (k : Type*) [Field k] {n : ℕ}

private theorem affineEquation_two (n : ℕ) :
    fermatAffineEquation k n 2 = X (0 : Fin 2) ^ n + X 1 ^ n - 1 := by
  have h0 : TauCeti.dehomogenize (R := k) (2 : Fin 3) (X 0) = X 0 := by simp; rfl
  have h1 : TauCeti.dehomogenize (R := k) (2 : Fin 3) (X 1) = X 1 := by simp; rfl
  have h2 : TauCeti.dehomogenize (R := k) (2 : Fin 3) (X 2) = 1 := by simp
  change TauCeti.dehomogenize (R := k) (2 : Fin 3) (fermatEquation k n) = _
  simp only [fermatEquation_def, map_sub, map_add, map_pow, h0, h1, h2, one_pow]

private noncomputable def chartEval {a b : k} (h : a ^ n + b ^ n = 1) :
    FermatAffineRing k n 2 →ₐ[k] k :=
  Ideal.Quotient.liftₐ _ (aeval ![a, b]) (by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
    simp [affineEquation_two, h])

private theorem chartEval_mk {a b : k} (h : a ^ n + b ^ n = 1) (p : MvPolynomial (Fin 2) k) :
    chartEval k h (Ideal.Quotient.mk _ p) = aeval ![a, b] p := rfl

/-- The affine Fermat ring on the last standard chart has a rational point. -/
theorem fermatAffineRing_nontrivial_two (hn : 0 < n) : Nontrivial (FermatAffineRing k n 2) :=
  (chartEval k (a := 1) (b := 0) (by simp [zero_pow hn.ne'])).toRingHom.domain_nontrivial

variable [CharZero k] [IsAlgClosed k]

variable (F : Type*) [Field F] [Algebra k F] [Algebra (FermatAffineRing k n 2) F]
  [IsScalarTower k (FermatAffineRing k n 2) F] [IsFractionRing (FermatAffineRing k n 2) F]

omit [CharZero k] in
/-- The function field of the dehomogenized Fermat equation is generated by its two coordinates,
of which the first is transcendental. -/
theorem fermatAffineFractionField_coordinates (hn : 0 < n) :
    ∃ x y : F, Transcendental k x ∧ k⟮x, y⟯ = ⊤ ∧ x ^ n + y ^ n = 1 := by
  let A := FermatAffineRing k n 2
  let q : MvPolynomial (Fin 2) k →ₐ[k] A := Ideal.Quotient.mkₐ k _
  let f : A →ₐ[k] F := IsScalarTower.toAlgHom k A F
  let t (i : Fin 2) := f (q (X i))
  let x := t 0
  let y := t 1
  refine ⟨x, y, ?_, ?_, ?_⟩
  · intro hx
    have : Algebra.IsAlgebraic k k⟮x⟯ := isAlgebraic_adjoin_simple hx.isIntegral
    have hmem : x ∈ k⟮x⟯ := mem_adjoin_simple_self _ _
    rw [eq_bot_of_isAlgClosed_of_isAlgebraic k⟮x⟯] at hmem
    obtain ⟨c, hc⟩ := mem_bot.mp hmem
    have hc' : algebraMap k A c = q (X 0) := by
      apply IsFractionRing.injective A F
      rw [← IsScalarTower.algebraMap_apply]
      exact hc
    let e0 := chartEval k (n := n) (a := 0) (b := 1) (by simp [zero_pow hn.ne'])
    let e1 := chartEval k (n := n) (a := 1) (b := 0) (by simp [zero_pow hn.ne'])
    have hc0 : c = 0 := by
      have he := congrArg e0 hc'
      change e0 (algebraMap k A c) = e0 (Ideal.Quotient.mk _ (X 0)) at he
      have hec : e0 (algebraMap k A c) = c := e0.commutes c
      simpa only [hec, e0, chartEval_mk, aeval_X, Matrix.cons_val_zero] using he
    have hc1 : c = 1 := by
      have he := congrArg e1 hc'
      change e1 (algebraMap k A c) = e1 (Ideal.Quotient.mk _ (X 0)) at he
      have hec : e1 (algebraMap k A c) = c := e1.commutes c
      simpa only [hec, e1, chartEval_mk, aeval_X, Matrix.cons_val_zero] using he
    exact zero_ne_one (hc0.symm.trans hc1)
  · let E : IntermediateField k F := k⟮x, y⟯
    have hti (i : Fin 2) : t i ∈ E := by
      fin_cases i
      · exact subset_adjoin k _ (Set.mem_insert _ _)
      · exact subset_adjoin k _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hf (a : A) : f a ∈ E := by
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k _ a
      let tE (i : Fin 2) : E := ⟨t i, hti i⟩
      have he : E.val.comp (aeval tE) = f.comp q := by
        ext i
        simp [t, tE, q]
      change (f.comp q) p ∈ E
      rw [← he]
      exact (aeval tE p).property
    apply top_unique
    intro z _
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := A) z
    exact E.div_mem (hf a) (hf b)
  · have hzero : q (fermatAffineEquation k n 2) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hz := congrArg f hzero
    simp only [affineEquation_two, map_sub, map_add, map_pow, map_one, map_zero] at hz
    exact sub_eq_zero.mp hz

/-- The genus of the fraction field of the affine Fermat equation is the plane-curve genus. -/
theorem genus_fermatAffineFractionField (hn : 0 < n) :
    TauCeti.genus k F = (n - 1) * (n - 2) / 2 := by
  obtain ⟨x, y, hx, hgen, hxy⟩ := fermatAffineFractionField_coordinates (n := n) k F hn
  exact genus_eq_of_fermatEquation hn hx hgen hxy

end TinyTauDemo
