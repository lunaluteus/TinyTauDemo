/-!
# Function field of an affine Fermat chart

See `/roadmap/index.qmd#prp-fermat-genus` @ `b2c9a29565e4747906e07cca00173aa6354b72f0`.
-/

public section

open MvPolynomial IntermediateField
open scoped IntermediateField

namespace TinyTauDemo

section AffineCoordinates

variable (k : Type*) [Field k] {n : ℕ}

/-- The affine Fermat ring on the last standard chart has a rational point. -/
theorem fermatAffineRing_nontrivial_two (hn : 0 < n) : Nontrivial (FermatAffineRing k n 2) :=
  (fermatLastChartEval (a := 1) (b := 0) (by simp [zero_pow hn.ne'])).toRingHom.domain_nontrivial

variable [CharZero k] [IsAlgClosed k]

variable (F : Type*) [Field F] [Algebra k F] [Algebra (FermatAffineRing k n 2) F]
  [IsScalarTower k (FermatAffineRing k n 2) F] [IsFractionRing (FermatAffineRing k n 2) F]

omit [CharZero k] in
/-- The function field of the dehomogenized Fermat equation is generated by its two coordinates,
of which the first is transcendental. -/
theorem fermatAffineFractionField_explicit_coordinates (hn : 0 < n) :
    let A := FermatAffineRing k n 2
    let x := algebraMap A F (Ideal.Quotient.mk _ (X (0 : Fin 2)))
    let y := algebraMap A F (Ideal.Quotient.mk _ (X (1 : Fin 2)))
    Transcendental k x ∧ k⟮x, y⟯ = ⊤ ∧ x ^ n + y ^ n = 1 := by
  dsimp only
  let A := FermatAffineRing k n 2
  let q : MvPolynomial (Fin 2) k →ₐ[k] A := Ideal.Quotient.mkₐ k _
  let f : A →ₐ[k] F := IsScalarTower.toAlgHom k A F
  let t (i : Fin 2) := f (q (X i))
  let x := t 0
  let y := t 1
  change Transcendental k x ∧ k⟮x, y⟯ = ⊤ ∧ x ^ n + y ^ n = 1
  refine ⟨?_, ?_, ?_⟩
  · intro hx
    have : Algebra.IsAlgebraic k k⟮x⟯ := isAlgebraic_adjoin_simple hx.isIntegral
    have hmem : x ∈ k⟮x⟯ := mem_adjoin_simple_self _ _
    rw [eq_bot_of_isAlgClosed_of_isAlgebraic k⟮x⟯] at hmem
    obtain ⟨c, hc⟩ := mem_bot.mp hmem
    have hc' : algebraMap k A c = q (X 0) := by
      apply IsFractionRing.injective A F
      rw [← IsScalarTower.algebraMap_apply]
      exact hc
    let e0 := fermatLastChartEval (k := k) (n := n) (a := 0) (b := 1) (by simp [zero_pow hn.ne'])
    let e1 := fermatLastChartEval (k := k) (n := n) (a := 1) (b := 0) (by simp [zero_pow hn.ne'])
    have hc0 : c = 0 := by
      have he := congrArg e0 hc'
      change e0 (algebraMap k A c) = e0 (Ideal.Quotient.mkₐ k _ (X 0)) at he
      have hec : e0 (algebraMap k A c) = c := e0.commutes c
      simpa only [hec, e0, fermatLastChartEval_mk, aeval_X, Matrix.cons_val_zero] using he
    have hc1 : c = 1 := by
      have he := congrArg e1 hc'
      change e1 (algebraMap k A c) = e1 (Ideal.Quotient.mkₐ k _ (X 0)) at he
      have hec : e1 (algebraMap k A c) = c := e1.commutes c
      simpa only [hec, e1, fermatLastChartEval_mk, aeval_X, Matrix.cons_val_zero] using he
    exact zero_ne_one (hc0.symm.trans hc1)
  · let E : IntermediateField k F := k⟮x, y⟯
    have hti (i : Fin 2) : t i ∈ E := by
      fin_cases i
      · exact subset_adjoin k _ (Set.mem_insert _ _)
      · exact subset_adjoin k _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hf (a : A) : f a ∈ E := by
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k _ a
      let tE (i : Fin 2) : E := ⟨t i, hti i⟩
      have he : E.val.comp (aeval tE) = f.comp q := by
        ext i
        simp [t, tE, q]
      change (f.comp q) p ∈ E
      rw [← he]
      exact (aeval tE p).property
    apply top_unique
    intro z _
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := A) z
    exact E.div_mem (hf a) (hf b)
  · have hzero : q (fermatAffineEquation k n 2) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hz := congrArg f hzero
    simp only [fermatAffineEquation_last, map_sub, map_add, map_pow, map_one, map_zero] at hz
    exact sub_eq_zero.mp hz


omit [CharZero k] in
/-- The fraction field of the last affine chart is generated by two Fermat coordinates. -/
theorem fermatAffineFractionField_coordinates (hn : 0 < n) :
    ∃ x y : F, Transcendental k x ∧ k⟮x, y⟯ = ⊤ ∧ x ^ n + y ^ n = 1 :=
  ⟨_, _, fermatAffineFractionField_explicit_coordinates k F hn⟩

/-- The genus of the fraction field of the affine Fermat equation is the plane-curve genus. -/
theorem genus_fermatAffineFractionField (hn : 0 < n) :
    TauCeti.genus k F = (n - 1) * (n - 2) / 2 := by
  obtain ⟨x, y, hx, hgen, hxy⟩ := fermatAffineFractionField_coordinates (n := n) k F hn
  exact genus_eq_of_fermatEquation hn hx hgen hxy

end AffineCoordinates

section ProjectionDegree

open Polynomial

variable {k : Type*} [Field k] {n : ℕ}

private theorem fermatAffine_as_bivariate (k : Type*) [Field k] (n : ℕ) :
    (Bivariate.equivMvPolynomial k).symm (TauCeti.dehomogenize (2 : Fin 3) (fermatEquation k n)) =
      Polynomial.X ^ n - Polynomial.C (1 - Polynomial.X ^ n) := by
  change (Bivariate.equivMvPolynomial k).symm (fermatAffineEquation k n 2) = _
  rw [fermatAffineEquation_last]
  simp only [map_sub, map_add, map_pow, map_one,
    Bivariate.equivMvPolynomial_symm_X_0, Bivariate.equivMvPolynomial_symm_X_1]
  ring

/-- The Fermat coordinate projection has degree `n` when the second coordinate
generates the field over the rational field of the first coordinate. -/
theorem fermatProjection_finrank
    [CharZero k] [IsAlgClosed k] {F : Type*} [Field F]
    [Algebra k F] [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F]
    (hn : 0 < n) {b : F} (hgen : (RatFunc k)⟮b⟯ = ⊤)
    (h : (algebraMap (RatFunc k) F RatFunc.X) ^ n + b ^ n = 1) :
    Module.finrank (RatFunc k) F = n := by
  let g := TauCeti.dehomogenize (2 : Fin 3) (fermatEquation k n)
  have hpoly : (Bivariate.equivMvPolynomial k).symm g =
      Polynomial.X ^ n - Polynomial.C (1 - Polynomial.X ^ n) :=
    fermatAffine_as_bivariate k n
  have hdeg : ((Bivariate.equivMvPolynomial k).symm g).natDegree = n := by
    rw [hpoly, natDegree_X_pow_sub_C]
  have hnonunit : ¬ IsUnit g := by
    intro hu
    have := natDegree_eq_zero_of_isUnit (hu.map (Bivariate.equivMvPolynomial k).symm)
    exact hn.ne' (hdeg.symm.trans this)
  have hirr : Irreducible g := by
    have hh := TauCeti.irreducible_map_dehomogenize (K := k) (by decide : 2 ≤ 2)
      (fermatEquation_isHomogeneous k n)
      (fun v hv _ ↦ fermatEquation_exists_aeval_pderiv_ne_zero hn v hv) (2 : Fin 3) hnonunit
    simpa only [Algebra.algebraMap_self, MvPolynomial.map_id] using hh
  have hmon : ((Bivariate.equivMvPolynomial k).symm g).Monic := by
    rw [hpoly]
    exact monic_X_pow_sub_C _ hn.ne'
  have hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, b] g = 0 := by
    dsimp only [g]
    have hcoords : (2 : Fin 3).insertNth (1 : F) ![algebraMap (RatFunc k) F RatFunc.X, b] =
        ![algebraMap (RatFunc k) F RatFunc.X, b, (1 : F)] := by
      ext i
      fin_cases i <;> rfl
    rw [TauCeti.aeval_dehomogenize, hcoords]
    exact (aeval_fermatEquation_eq_zero_iff n _ _).mpr h
  exact (TauCeti.finrank_ratFunc_eq_natDegree_of_aeval_eq_zero hirr hmon hgen hy).trans hdeg

end ProjectionDegree

end TinyTauDemo
