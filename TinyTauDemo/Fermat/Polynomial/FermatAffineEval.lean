/-! # Evaluation at the normalized Fermat coordinates -/

public section

open MvPolynomial
open scoped IntermediateField

namespace TinyTauDemo

variable {k F : Type*} [Field k] [Field F] [Algebra k F] {n : ℕ}

/-- A pair of coordinates on the Fermat curve annihilates the dehomogenized equation. -/
theorem aeval_fermatAffineEquation_two_eq_zero {a b : F} (h : a ^ n + b ^ n = 1) :
    aeval ![a, b] (fermatAffineEquation k n 2) = 0 := by
  have hinsert : (2 : Fin 3).insertNth 1 ![a, b] = ![a, b, 1] := by
    ext i
    fin_cases i <;> rfl
  rw [fermatAffineEquation, TauCeti.aeval_dehomogenize, hinsert]
  exact (aeval_fermatEquation_eq_zero_iff n a b).mpr h

/-- Evaluation of the last affine chart at the point with coordinates a and b. -/
noncomputable def fermatAffineEval (a b : F) (h : a ^ n + b ^ n = 1) :
    FermatAffineRing k n 2 →ₐ[k] F :=
  Ideal.Quotient.liftₐ _ (aeval ![a, b]) (by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
    rw [map_mul, aeval_fermatAffineEquation_two_eq_zero h, zero_mul])

/-- Evaluation on a class is given by polynomial evaluation. -/
@[simp]
theorem fermatAffineEval_mk (a b : F) (h : a ^ n + b ^ n = 1)
    (p : MvPolynomial (Fin 2) k) :
    fermatAffineEval (k := k) a b h (Ideal.Quotient.mk _ p) = aeval ![a, b] p := by
  rfl

variable [CharZero k]

/-- A Fermat point with a transcendental first coordinate gives a faithful evaluation
of the last affine chart. -/
theorem fermatAffineEval_injective {a b : F} (h : a ^ n + b ^ n = 1)
    (hn : 0 < n) (ha : Transcendental k a) :
    Function.Injective (fermatAffineEval (k := k) a b h) := by
  let g := fermatAffineEquation k n 2
  have hzero : aeval ![a, b] g = 0 := aeval_fermatAffineEquation_two_eq_zero h
  have hnonunit : ¬ IsUnit g := by
    intro hu
    have h := hu.map (aeval ![a, b])
    rw [hzero] at h
    exact not_isUnit_zero h
  have hirr : Irreducible g := Irreducible.of_map <|
    TauCeti.irreducible_map_dehomogenize (K := AlgebraicClosure k) (by decide : 2 ≤ 2)
      (fermatEquation_isHomogeneous k n)
      (fun b hb _ => fermatEquation_exists_aeval_pderiv_ne_zero hn b hb) (2 : Fin 3) hnonunit
  have hker := TauCeti.ker_aeval_eq_span_singleton_of_irreducible hirr ha hzero
  apply (injective_iff_map_eq_zero _).mpr
  intro q hq
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [fermatAffineEval_mk] at hq
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [← hker]
  exact RingHom.mem_ker.mpr hq

omit [CharZero k] in
/-- Evaluating the affine chart gives the subalgebra generated by the two coordinates. -/
theorem fermatAffineEval_range {a b : F} (h : a ^ n + b ^ n = 1) :
    (fermatAffineEval (k := k) a b h).range = Algebra.adjoin k {a, b} := by
  let q : MvPolynomial (Fin 2) k →ₐ[k] FermatAffineRing k n 2 := Ideal.Quotient.mkₐ k _
  let f := fermatAffineEval (k := k) a b h
  have hq : q.range = ⊤ := (AlgHom.range_eq_top q).mpr (Ideal.Quotient.mkₐ_surjective k _)
  have hcomp : f.comp q = aeval ![a, b] := by
    ext i
    rw [AlgHom.comp_apply]
    exact fermatAffineEval_mk a b h (X i)
  have hpair : Set.range (![a, b] : Fin 2 → F) = {a, b} := by
    ext c
    simp [or_comm]
  have heval := congrArg AlgHom.range hcomp
  rw [AlgHom.range_comp, hq, Algebra.map_top, MvPolynomial.aeval_range, hpair] at heval
  exact heval

/-- Evaluation of the affine chart with codomain the field generated by its two coordinates. -/
noncomputable def fermatAffineEvalAdjoin {a b : F} (h : a ^ n + b ^ n = 1) :
    FermatAffineRing k n 2 →ₐ[k] k⟮a, b⟯ :=
  (fermatAffineEval (k := k) a b h).codRestrict (k⟮a, b⟯ : IntermediateField k F).toSubalgebra
    (fun p => show fermatAffineEval (k := k) a b h p ∈
        (k⟮a, b⟯ : IntermediateField k F).toSubalgebra from
      (Algebra.adjoin_le (IntermediateField.subset_adjoin k {a, b} : _))
        ((fermatAffineEval_range (k := k) h) ▸ ⟨p, rfl⟩))

/-- The chart algebra structure on the field generated by its two coordinates. -/
noncomputable abbrev fermatAffineAdjoinAlgebra {a b : F} (h : a ^ n + b ^ n = 1) :
    Algebra (FermatAffineRing k n 2) k⟮a, b⟯ :=
  (fermatAffineEvalAdjoin (k := k) h).toRingHom.toAlgebra

omit [CharZero k] in
/-- The chart algebra map for the generated field is given by normalized evaluation. -/
theorem fermatAffineAdjoin_algebraMap {a b : F} (h : a ^ n + b ^ n = 1)
    (p : FermatAffineRing k n 2) :
    letI := fermatAffineAdjoinAlgebra (k := k) h
    (algebraMap (FermatAffineRing k n 2) k⟮a, b⟯ p : F) = fermatAffineEval (k := k) a b h p := by
  rfl

omit [CharZero k] in
/-- The chart evaluation algebra on the generated field is compatible with the base field. -/
theorem fermatAffineAdjoin_isScalarTower {a b : F} (h : a ^ n + b ^ n = 1) :
    letI := fermatAffineAdjoinAlgebra (k := k) h
    IsScalarTower k (FermatAffineRing k n 2) k⟮a, b⟯ := by
  let := fermatAffineAdjoinAlgebra (k := k) h
  apply IsScalarTower.of_algebraMap_eq
  intro c
  exact ((fermatAffineEvalAdjoin (k := k) h).commutes c).symm

section FractionField

variable (L : Type*) [Field L] [Algebra k L] [Algebra (FermatAffineRing k n 2) L]
  [IsScalarTower k (FermatAffineRing k n 2) L] [IsFractionRing (FermatAffineRing k n 2) L]

/-- The injective evaluation extends to the function field of the last chart. -/
noncomputable def fermatAffineFractionEval {a b : F} (h : a ^ n + b ^ n = 1)
    (hn : 0 < n) (ha : Transcendental k a) : L →ₐ[k] F :=
  IsFractionRing.liftAlgHom (fermatAffineEval_injective h hn ha)

/-- The extended evaluation agrees with evaluation on the affine coordinate ring. -/
@[simp]
theorem fermatAffineFractionEval_algebraMap {a b : F} (h : a ^ n + b ^ n = 1)
    (hn : 0 < n) (ha : Transcendental k a) (p : FermatAffineRing k n 2) :
    fermatAffineFractionEval L h hn ha (algebraMap (FermatAffineRing k n 2) L p) =
      fermatAffineEval (k := k) a b h p := by
  unfold fermatAffineFractionEval
  rw [IsFractionRing.coe_liftAlgHom, IsFractionRing.lift_algebraMap]
  rfl

/-- The function-field evaluation has image the field generated by the two coordinates. -/
theorem fermatAffineFractionEval_fieldRange {a b : F} (h : a ^ n + b ^ n = 1)
    (hn : 0 < n) (ha : Transcendental k a) :
    (fermatAffineFractionEval L h hn ha).fieldRange = k⟮a, b⟯ := by
  unfold fermatAffineFractionEval
  apply IsFractionRing.liftAlgHom_fieldRange_eq_of_range_eq
  exact fermatAffineEval_range (k := k) h

/-- The rational functions generated by a Fermat point identify with the function field of the
last chart when the first coordinate is transcendental. -/
noncomputable def fermatAffineFractionEquivAdjoin {a b : F}
    (h : a ^ n + b ^ n = 1) (hn : 0 < n) (ha : Transcendental k a) : L ≃ₐ[k] k⟮a, b⟯ :=
  (AlgEquiv.ofInjectiveField (fermatAffineFractionEval L h hn ha)).trans
    (IntermediateField.equivOfEq (fermatAffineFractionEval_fieldRange L h hn ha))

end FractionField

/-- The generated coordinate field is the fraction field of the chart under evaluation. -/
theorem fermatAffineAdjoin_isFractionRing {a b : F} (h : a ^ n + b ^ n = 1)
    (hn : 0 < n) (ha : Transcendental k a) :
    letI := fermatAffineAdjoinAlgebra (k := k) h
    IsFractionRing (FermatAffineRing k n 2) k⟮a, b⟯ := by
  let A := FermatAffineRing k n 2
  let E := k⟮a, b⟯
  let := fermatAffineAdjoinAlgebra (k := k) h
  have hinj := fermatAffineEval_injective (k := k) h hn ha
  have : IsDomain A := Function.Injective.isDomain (fermatAffineEval a b h) hinj
  have : FaithfulSMul A E := (faithfulSMul_iff_algebraMap_injective A E).mpr
    (fun _ _ he => hinj (congrArg Subtype.val he))
  let L := FractionRing A
  let e := fermatAffineFractionEquivAdjoin L h hn ha
  have he (p : A) : e (algebraMap A L p) = algebraMap A E p := by
    apply Subtype.ext
    change fermatAffineFractionEval L h hn ha (algebraMap A L p) = fermatAffineEval a b h p
    exact fermatAffineFractionEval_algebraMap L h hn ha p
  apply IsFractionRing.of_field
  intro z
  obtain ⟨x, y, -, hxy⟩ := IsFractionRing.div_surjective (A := A) (e.symm z)
  refine ⟨x, y, ?_⟩
  rw [← e.apply_symm_apply z, ← hxy, map_div₀, he, he]

open Polynomial in
/-- Normalizing a primitive Fermat solution gives an injective evaluation of the affine chart
in the rational function field. -/
theorem PrimitiveFermatSolution.fermatAffineEval_ratFunc_injective {x y z : k[X]}
    (h : PrimitiveFermatSolution n x y z) (hn : 0 < n) :
    Function.Injective (fermatAffineEval (k := k)
      (algebraMap k[X] (RatFunc k) x / algebraMap k[X] (RatFunc k) z)
      (algebraMap k[X] (RatFunc k) y / algebraMap k[X] (RatFunc k) z)
      h.ratFunc_div_pow_add_div_pow) :=
  fermatAffineEval_injective h.ratFunc_div_pow_add_div_pow hn
    (h.transcendental_ratFunc_div hn)

end TinyTauDemo
