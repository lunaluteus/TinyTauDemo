/-!
# A Kummer extension unramified at every finite prime

A nontrivial automorphism changes the translated Kummer root by a unit. The translated
root is integral, so this excludes the automorphism from inertia at every prime.
See `/roadmap/index.qmd#rem-kummer-unit-proof @ a52492b8f33f733e4b629d020fd9c912797d6a97`.
-/

public section

open IsDedekindDomain NumberField Polynomial
open scoped IntermediateField

namespace TinyTauDemo

variable {K L : Type*} [Field K] [Field L] [Algebra K L]
  {p : ℕ} [hp : Fact p.Prime] {ζ : K} (hζ : IsPrimitiveRoot ζ p)

private theorem kummer_automorphism_mul_root_of_unfixed
    {u : 𝓞 K} {r : L} (hr : r ^ p = algebraMap (𝓞 K) L u) (hr₀ : r ≠ 0)
    (σ : Gal(L/K)) (hσ : σ r ≠ r) :
    ∃ v : (𝓞 K)ˣ,
      σ r - r = (algebraMap (𝓞 K) L (1 - hζ.toInteger) *
        algebraMap (𝓞 K) L (v : 𝓞 K)) * r := by
  let φ := algebraMap (𝓞 K) L
  have hfix (x : 𝓞 K) : σ (φ x) = φ x := by
    dsimp only [φ]
    rw [IsScalarTower.algebraMap_apply (𝓞 K) K L, σ.commutes]
  have hu₀ : φ u ≠ 0 := hr ▸ pow_ne_zero p hr₀
  have hratio : (σ r / r) ^ p = 1 := by
    rw [div_pow, ← map_pow, hr, hfix, div_self hu₀]
  have hζL := hζ.map_of_injective (algebraMap K L).injective
  obtain ⟨j, hj, hratio_eq⟩ := hζL.eq_pow_of_pow_eq_one hratio
  have hj₀ : j ≠ 0 := by
    rintro rfl
    rw [pow_zero] at hratio_eq
    exact hσ ((div_eq_iff hr₀).mp hratio_eq.symm |>.trans (one_mul r))
  have hφζ : φ hζ.toInteger = algebraMap K L ζ := by
    dsimp only [φ]
    rw [IsScalarTower.algebraMap_apply (𝓞 K) K L]
    rfl
  have hσr : σ r = φ (hζ.toInteger ^ j) * r := by
    apply (div_eq_iff hr₀).mp
    rw [map_pow, hφζ, hratio_eq]
  have hassoc : Associated (1 - hζ.toInteger) (hζ.toInteger ^ j - 1) := by
    rw [← neg_sub, Associated.neg_left_iff]
    exact hζ.toInteger_isPrimitiveRoot.associated_sub_one_pow_sub_one_of_coprime
      (Nat.coprime_of_lt_prime hj₀ hj hp.out).symm
  obtain ⟨v, hv⟩ := hassoc
  refine ⟨v, ?_⟩
  change σ r - r = (φ (1 - hζ.toInteger) * φ v) * r
  rw [← map_mul, hv, map_sub, map_one, hσr, sub_mul, one_mul]

/-- For a Kummer extension generated by a root of a unit congruent to one modulo
the `p`-th power of the cyclotomic uniformizer, every prime has trivial inertia. -/
theorem inertia_eq_bot_of_kummer_unit
    (u : (𝓞 K)ˣ) {r : L} (hr : r ^ p = algebraMap (𝓞 K) L (u : 𝓞 K))
    (hgen : K⟮r⟯ = ⊤)
    (hu : (1 - hζ.toInteger) ^ p ∣ (u : 𝓞 K) - 1)
    (Q : Ideal (𝓞 L)) [Q.IsPrime] :
    Q.inertia (Gal(L/K)) = ⊥ := by
  let φ := algebraMap (𝓞 K) (𝓞 L)
  let ψ := algebraMap (𝓞 K) L
  let π := 1 - hζ.toInteger
  have hcoe (x : 𝓞 K) : (φ x : L) = ψ x :=
    (IsScalarTower.algebraMap_apply (𝓞 K) (𝓞 L) L x).symm
  have hπ : ψ π ≠ 0 := by
    dsimp only [ψ]
    rw [IsScalarTower.algebraMap_apply (𝓞 K) K L]
    apply (map_ne_zero (algebraMap K L)).2
    change (algebraMap (𝓞 K) K π) ≠ 0
    rw [show π = 1 - hζ.toInteger from rfl, map_sub, map_one]
    exact sub_ne_zero.mpr (hζ.ne_one hp.out.one_lt).symm
  have hπp : π ^ (p - 1) ∣ (p : 𝓞 K) := by
    apply Ideal.span_singleton_le_span_singleton.mp
    rw [← Ideal.span_singleton_pow, hζ.span_natCast_eq_span_one_sub_pow]
  have hunit : IsUnit (ψ (u : 𝓞 K)) := u.isUnit.map ψ
  have hr₀ : r ≠ 0 := by
    rintro rfl
    rw [zero_pow hp.out.ne_zero] at hr
    exact hunit.ne_zero hr.symm
  have hri : IsIntegral ℤ r :=
    IsIntegral.of_pow hp.out.pos (hr ▸ (u : 𝓞 K).isIntegral_coe.algebraMap)
  let α : 𝓞 L := ⟨r, hri⟩
  have hαpow : α ^ p = φ (u : 𝓞 K) := by
    apply RingOfIntegers.coe_injective
    change (algebraMap (𝓞 L) L) (α ^ p) = (φ (u : 𝓞 K) : L)
    rw [map_pow, hcoe]
    exact hr
  have hαunit : IsUnit α :=
    (isUnit_pow_iff hp.out.ne_zero).mp (hαpow ▸ u.isUnit.map φ)
  refine le_antisymm ?_ bot_le
  intro σ hσI
  have hσfix : σ r = r := by
    by_contra hσ
    obtain ⟨v, hv⟩ := kummer_automorphism_mul_root_of_unfixed hζ hr hr₀ σ hσ
    let w := φ (v : 𝓞 K) * α
    have hw : w ∉ Q := Q.notMem_of_isUnit ((v.isUnit.map φ).mul hαunit)
    let t := (r - 1) / ψ π
    have hti : IsIntegral ℤ t :=
      isIntegral_trans t (isIntegral_sub_one_div_of_prime_pow hp.out hπ hπp hu hr)
    let θ : 𝓞 L := ⟨t, hti⟩
    have hθ : σ • θ - θ = w := by
      apply RingOfIntegers.coe_injective
      change (algebraMap (𝓞 L) L) (σ • θ - θ) =
        (algebraMap (𝓞 L) L) (φ (v : 𝓞 K) * α)
      rw [map_sub, map_mul]
      change σ t - t = (φ (v : 𝓞 K) : L) * r
      rw [hcoe]
      have hfix : σ (ψ π) = ψ π := by
        dsimp only [ψ]
        rw [IsScalarTower.algebraMap_apply (𝓞 K) K L, σ.commutes]
      dsimp only [t]
      rw [map_div₀, map_sub, map_one, hfix, ← sub_div, sub_sub_sub_cancel_right, hv]
      rw [mul_assoc, mul_div_cancel_left₀ _ hπ]
    exact hw (hθ ▸ Ideal.mem_inertia.mp hσI θ)
  apply Subgroup.mem_bot.mpr
  ext x
  have hall := (IntermediateField.forall_mem_adjoin_smul_eq_self_iff
    (F := K) (S := ({r} : Set L)) σ).2 (by simpa using hσfix)
  rw [hgen] at hall
  exact hall x IntermediateField.mem_top

variable [NumberField K] [NumberField L]

include hζ in
private theorem isGalois_of_kummer_unit
    (u : (𝓞 K)ˣ) {r : L} (hr : r ^ p = algebraMap (𝓞 K) L (u : 𝓞 K))
    (hgen : K⟮r⟯ = ⊤) : IsGalois K L := by
  let a : K := (u : 𝓞 K)
  have hr' : r ^ p = algebraMap K L a := by
    simpa only [IsScalarTower.algebraMap_apply (𝓞 K) K L] using hr
  let : IsSplittingField K L (X ^ p - C a) := by
    constructor
    · rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_C, Polynomial.map_X]
      exact X_pow_sub_C_splits_of_isPrimitiveRoot
        (hζ.map_of_injective (algebraMap K L).injective) hr'
    · rw [eq_top_iff, ← IntermediateField.top_toSubalgebra, ← hgen,
        IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (IsAlgebraic.of_finite K r)]
      apply Algebra.adjoin_mono
      rw [Set.singleton_subset_iff, mem_rootSet_of_ne (X_pow_sub_C_ne_zero hp.out.pos a),
        aeval_def, eval₂_sub, eval₂_X_pow, eval₂_C, hr', sub_self]
  exact IsGalois.of_separable_splitting_field (separable_X_pow_sub_C a
    (Nat.cast_ne_zero.mpr hp.out.ne_zero) (u.isUnit.map (algebraMap (𝓞 K) K)).ne_zero)

/-- Every finite prime of a Kummer extension generated by the root of a unit congruent
to one modulo the `p`-th power of the cyclotomic uniformizer is unramified. -/
theorem isUnramifiedAt_of_kummer_unit
    (u : (𝓞 K)ˣ) {r : L} (hr : r ^ p = algebraMap (𝓞 K) L (u : 𝓞 K))
    (hgen : K⟮r⟯ = ⊤)
    (hu : (1 - hζ.toInteger) ^ p ∣ (u : 𝓞 K) - 1)
    (Q : HeightOneSpectrum (𝓞 L)) :
    Algebra.IsUnramifiedAt (𝓞 K) Q.asIdeal := by
  let : IsGalois K L := isGalois_of_kummer_unit hζ u hr hgen
  let := IsGaloisGroup.of_isFractionRing Gal(L/K) (𝓞 K) (𝓞 L) K L
  let P := Q.asIdeal.under (𝓞 K)
  let : Finite ((𝓞 K) ⧸ P) :=
    Ring.HasFiniteQuotients.finiteQuotient (Ideal.under_ne_bot (𝓞 K) Q.ne_bot)
  apply Ideal.ramificationIdx_eq_one_iff.mp
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx P Q.asIdeal Gal(L/K),
    ← Ideal.card_inertia_eq_ramificationIdxIn (G := Gal(L/K)) P Q.asIdeal,
    inertia_eq_bot_of_kummer_unit hζ u hr hgen hu Q.asIdeal, Subgroup.card_bot]

end TinyTauDemo
