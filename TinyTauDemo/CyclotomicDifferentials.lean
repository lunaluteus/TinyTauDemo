/-!
# Differentials of a prime cyclotomic extension

A monogenic algebra has a differential module generated by the differential of the
adjoined root, with the derivative of the defining polynomial as its relation.
In a prime cyclotomic extension this relation generates the same power of
the cyclotomic prime as the different ideal.
See `/roadmap/index.qmd#rem-arithmetic-surface @ bbe140af3c513a338de3607b9e0c88a26a1aa994`.
-/

public section

open Polynomial KaehlerDifferential

namespace IsAdjoinRoot

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
  {f : R[X]} (h : IsAdjoinRoot S f)

/-- The differentials of a monogenic algebra are the quotient by the evaluated derivative. -/
noncomputable def kaehlerDifferentialEquivQuotient :
    Ω[S⁄R] ≃ₗ[S] S ⧸ Ideal.span {h.map (derivative f)} := by
  let J : Ideal S := Ideal.span {h.map (derivative f)}
  let q : S →ₐ[R] S ⧸ J := Ideal.Quotient.mkₐ R J
  let dP : R[X] →ₗ[R] S ⧸ J := (q.comp h.map).toLinearMap.comp derivative
  have hrel : q (h.map (derivative f)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hker : LinearMap.ker h.map.toLinearMap ≤ LinearMap.ker dP := by
    intro g hg
    obtain ⟨a, rfl⟩ := h.map_eq_zero_iff.mp (LinearMap.mem_ker.mp hg)
    change q (h.map (derivative (f * a))) = 0
    rw [derivative_mul, map_add, map_mul, map_mul, map_add, map_mul, map_mul,
      hrel, h.map_self, map_zero, zero_mul, zero_mul, add_zero]
  let dS : S →ₗ[R] S ⧸ J := h.map.toLinearMap.liftOfSurjective h.map_surjective ⟨dP, hker⟩
  have hdS (g : R[X]) : dS (h.map g) = q (h.map (derivative g)) :=
    LinearMap.equivOfSurjective_apply h.map_surjective hker
  let d : Derivation R S (S ⧸ J) := Derivation.mk' dS (by
    intro a b
    obtain ⟨g, rfl⟩ := h.map_surjective a
    obtain ⟨k, rfl⟩ := h.map_surjective b
    rw [← map_mul, hdS, hdS, hdS, derivative_mul, map_add, map_mul, map_mul, map_add,
      map_mul, map_mul, Algebra.smul_def, Algebra.smul_def]
    change _ = q (h.map g) * _ + q (h.map k) * _
    ring)
  have hdroot : d h.root = 1 := by
    change dS (h.map X) = 1
    rw [hdS, derivative_X, map_one, map_one]
  let t := LinearMap.toSpanSingleton S Ω[S⁄R] (D R S h.root)
  have ht : Function.Surjective t := by
    apply LinearMap.range_eq_top.mp
    have hle : Submodule.span S (Set.range (D R S)) ≤ LinearMap.range t := by
      rw [Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      obtain ⟨g, rfl⟩ := h.map_surjective x
      refine ⟨h.map (derivative g), ?_⟩
      change h.map (derivative g) • D R S h.root = D R S (h.map g)
      simpa only [h.aeval_root_eq_map] using ((D R S).map_aeval g h.root).symm
    rw [span_range_derivation] at hle
    exact top_unique hle
  have htker : LinearMap.ker t = (J : Submodule S S) := by
    apply le_antisymm
    · intro x hx
      have hz := congrArg d.liftKaehlerDifferential (LinearMap.mem_ker.mp hx)
      change d.liftKaehlerDifferential (x • D R S h.root) = d.liftKaehlerDifferential 0 at hz
      rw [map_smul, map_zero, Derivation.liftKaehlerDifferential_comp_D, hdroot,
        Algebra.smul_def, mul_one] at hz
      exact Ideal.Quotient.eq_zero_iff_mem.mp hz
    · apply Ideal.span_le.mpr
      intro x hx
      obtain rfl := Set.mem_singleton_iff.mp hx
      change h.map (derivative f) • D R S h.root = 0
      rw [← h.aeval_root_eq_map, ← (D R S).map_aeval, h.aeval_root_self, map_zero]
  exact (t.quotKerEquivOfSurjective ht).symm.trans
    (Submodule.quotEquivOfEq _ _ htker)

end IsAdjoinRoot

namespace IsPrimitiveRoot

open NumberField

variable {K : Type*} [Field K] [NumberField K] {p : ℕ} [hp : Fact p.Prime]
  [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p)

private theorem adjoin_toInteger_eq_top :
    Algebra.adjoin ℤ {hζ.toInteger} = ⊤ := by
  rw [← hζ.integralPowerBasis_gen]
  exact hζ.integralPowerBasis.adjoin_gen_eq_top

omit [IsCyclotomicExtension {p} ℚ K] in
/-- At a prime cyclotomic root the derivative of the integral minimal polynomial
generates the `(p - 2)`-nd power of the prime above `p`. -/
theorem span_aeval_derivative_minpoly_eq_span_one_sub_pow :
    Ideal.span {aeval hζ.toInteger (derivative (minpoly ℤ hζ.toInteger))} =
      (Ideal.span {1 - hζ.toInteger}) ^ (p - 2) := by
  let r := hζ.toInteger
  let E : Ideal (𝓞 K) := Ideal.span {1 - r}
  let d := aeval r (derivative (minpoly ℤ r))
  have hr : IsPrimitiveRoot r p := hζ.toInteger_isPrimitiveRoot
  have hf : cyclotomic p ℤ = minpoly ℤ r := calc
    cyclotomic p ℤ = minpoly ℤ ζ := cyclotomic_eq_minpoly hζ hp.out.pos
    _ = minpoly ℤ (r : K) := congrArg (minpoly ℤ) hζ.coe_toInteger.symm
    _ = minpoly ℤ r := RingOfIntegers.minpoly_coe r
  have hd : d * (r - 1) = (p : 𝓞 K) * r ^ (p - 1) := by
    have h := congrArg (fun g : ℤ[X] ↦ aeval r (derivative g))
      (cyclotomic_prime_mul_X_sub_one ℤ p)
    rw [hf] at h
    simpa only [derivative_mul, derivative_sub, derivative_X, derivative_one, sub_zero,
      mul_one, map_add, map_mul, map_one, map_sub, aeval_X, minpoly.aeval, add_zero,
      derivative_X_pow, aeval_C, map_natCast, map_pow] using h
  have hunit : IsUnit (r ^ (p - 1)) := (hr.isUnit hp.out.ne_zero).pow _
  have hm : (Ideal.span {d}) * E = E ^ (p - 1) := calc
    (Ideal.span {d}) * E = Ideal.span {d * (r - 1)} := by
      change Ideal.span {d} * Ideal.span {1 - hζ.toInteger} = _
      rw [hζ.span_one_sub_eq_span_zeta_sub_one, Ideal.span_singleton_mul_span_singleton]
    _ = Ideal.span {(p : 𝓞 K)} := by
      rw [hd, ← Ideal.span_singleton_mul_span_singleton,
        Ideal.span_singleton_eq_top.mpr hunit, Ideal.mul_top]
    _ = E ^ (p - 1) := hζ.span_natCast_eq_span_one_sub_pow
  have hE : E ≠ 0 := Ideal.span_singleton_eq_bot.not.mpr
    (sub_ne_zero.mpr (hr.ne_one hp.out.one_lt).symm)
  apply mul_right_cancel₀ hE
  rw [← pow_succ, show p - 2 + 1 = p - 1 by have := hp.out.two_le; omega]
  exact hm

/-- The different ideal is supported at the unique prime above `p` and has
the tame different exponent `p - 2`. -/
theorem differentIdeal_eq_span_one_sub_pow :
    differentIdeal ℤ (𝓞 K) = Ideal.span {1 - hζ.toInteger} ^ (p - 2) := by
  rw [TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly ℤ ℚ K (𝓞 K) _
    hζ.adjoin_toInteger_eq_top, hζ.span_aeval_derivative_minpoly_eq_span_one_sub_pow]

/-- The relative Kähler differentials of the prime cyclotomic integers are a
cyclic module with annihilator generated by `(1 - ζ) ^ (p - 2)`. -/
noncomputable def cyclotomicKaehlerDifferentialEquiv :
    Ω[𝓞 K⁄ℤ] ≃ₗ[𝓞 K] (𝓞 K ⧸ (Ideal.span {1 - hζ.toInteger}) ^ (p - 2)) := by
  let h := IsAdjoinRoot.mkOfAdjoinEqTop
    (RingOfIntegers.isIntegral hζ.toInteger) hζ.adjoin_toInteger_eq_top
  refine h.kaehlerDifferentialEquivQuotient.trans (Submodule.quotEquivOfEq _ _ ?_)
  exact hζ.span_aeval_derivative_minpoly_eq_span_one_sub_pow

include hζ in
/-- At an odd prime cyclotomic extension, the cover is étale exactly away from
the fiber of the rational prime. -/
theorem isEtaleAt_iff_natCast_notMem (hp2 : p ≠ 2) (P : Ideal (𝓞 K)) [P.IsPrime] :
    Algebra.IsEtaleAt ℤ P ↔ (p : 𝓞 K) ∉ P := by
  have : Algebra.FinitePresentation ℤ (𝓞 K) :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  have hEU : Algebra.IsEtaleAt ℤ P ↔ Algebra.IsUnramifiedAt ℤ P := by
    constructor
    · intro h
      let _ : Algebra.IsEtaleAt ℤ P := h
      infer_instance
    · intro h
      let _ : Algebra.IsUnramifiedAt ℤ P := h
      exact Algebra.IsEtaleAt.of_isUnramifiedAt_of_flat P
  have hp1 : p - 1 ≠ 0 := Nat.sub_ne_zero_of_lt hp.out.one_lt
  have hp2' : p - 2 ≠ 0 := Nat.sub_ne_zero_of_lt (lt_of_le_of_ne hp.out.two_le hp2.symm)
  rw [hEU, ← not_dvd_differentIdeal_iff, hζ.differentIdeal_eq_span_one_sub_pow,
    Ideal.dvd_iff_le, Ideal.IsPrime.pow_le_iff hp2', ← Ideal.IsPrime.pow_le_iff hp1,
    ← hζ.span_natCast_eq_span_one_sub_pow, Ideal.span_singleton_le_iff_mem]

include hζ in
/-- Inverting the rational prime gives an étale open subscheme of the cover. -/
theorem etale_localizationAway_natCast (hp2 : p ≠ 2) :
    Algebra.Etale ℤ (Localization.Away (p : 𝓞 K)) := by
  have : Algebra.FinitePresentation ℤ (𝓞 K) :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  apply (Algebra.basicOpen_subset_etaleLocus_iff_etale (R := ℤ) (f := (p : 𝓞 K))).mp
  intro P hP
  exact (hζ.isEtaleAt_iff_natCast_notMem hp2 P.asIdeal).mpr hP

end IsPrimitiveRoot

namespace TinyTauDemo

/-- The Kähler differential module of the integer ring over itself vanishes. -/
theorem subsingleton_kaehlerDifferential_int : Subsingleton Ω[ℤ⁄ℤ] :=
  KaehlerDifferential.subsingleton_of_surjective ℤ ℤ fun x ↦ ⟨x, by simp⟩

end TinyTauDemo
