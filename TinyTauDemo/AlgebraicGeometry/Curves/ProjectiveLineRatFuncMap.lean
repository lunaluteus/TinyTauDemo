module

public import TinyTauDemo.AlgebraicGeometry.Curves.ProjectiveLineDifferentials
public import TinyTauDemo.AlgebraicGeometry.Curves.FiniteCurveMorphisms
public import Mathlib.FieldTheory.RatFunc.IntermediateField
import TauCeti.AlgebraicGeometry.Birational.RationalMap
import TauCeti.AlgebraicGeometry.Morphisms.Dominant
import TauCeti.FieldTheory.RatFunc.Automorphism

/-!
# The projective-line map of a rational function

A nonconstant rational function determines a finite morphism of projective
lines. Pullback on rational functions is substitution through that function,
and the degree is the maximum of the degrees of its reduced coordinates.

See `/roadmap/index.qmd#rem-mason-hurwitz-bridge` @ `d2c4d4a566aab2eb4ba61e9bb96a4fcd4b9e7eaa`.
-/

public section

open AlgebraicGeometry CategoryTheory Polynomial TopologicalSpace
open TauCeti TauCeti.AlgebraicGeometry
open scoped IntermediateField

namespace TinyTauDemo

universe u

variable {k : Type u} [Field k]

/-- Substitute a transcendental rational function for the affine coordinate. -/
noncomputable def ratFuncSubstitution (f : RatFunc k) (hf : Transcendental k f) :
    RatFunc k →ₐ[k] RatFunc k :=
  (IntermediateField.val k⟮f⟯).comp (RatFunc.algEquivOfTranscendental f hf).toAlgHom

/-- Substitution evaluates the numerator and denominator of a rational function. -/
theorem ratFuncSubstitution_apply (f : RatFunc k) (hf : Transcendental k f) (z : RatFunc k) :
    ratFuncSubstitution f hf z = aeval f z.num / aeval f z.denom :=
  RatFunc.algEquivOfTranscendental_apply f hf z

/-- Substitution sends the affine coordinate to the given rational function. -/
@[simp] theorem ratFuncSubstitution_X (f : RatFunc k) (hf : Transcendental k f) :
    ratFuncSubstitution f hf RatFunc.X = f :=
  RatFunc.algEquivOfTranscendental_X f hf

/-- The embedded rational function field is the subfield generated by the substituted function. -/
theorem fieldRange_ratFuncSubstitution (f : RatFunc k) (hf : Transcendental k f) :
    (ratFuncSubstitution f hf).fieldRange = k⟮f⟯ := by
  ext z
  constructor
  · rintro ⟨u, rfl⟩
    exact (RatFunc.algEquivOfTranscendental f hf u).2
  · intro hz
    let e := RatFunc.algEquivOfTranscendental f hf
    exact ⟨e.symm ⟨z, hz⟩, congrArg Subtype.val (e.apply_symm_apply ⟨z, hz⟩)⟩

local notation "P₁" => projectiveLine k
local notation "F₁" => Scheme.functionField (projectiveLine k)

private noncomputable def substitutionOnFunctionField (f : RatFunc k) (hf : Transcendental k f) :
    F₁ →ₐ[k] F₁ :=
  let e := projectiveLine.functionFieldEquiv k
  e.symm.toAlgHom.comp ((ratFuncSubstitution f hf).comp e.toAlgHom)

private theorem projectiveLine_valuationRing_stalk (x : P₁) :
    ValuationRing ((P₁).presheaf.stalk x) := by
  let := projectiveLine_isCurveOver k
  let := projectiveLine_smoothOfRelativeDimension k
  let := isDiscreteValuationRing_stalk_of_codimensionOne_smoothCurve (k := k) (X := P₁)
  exact Scheme.IsCurveOver.valuationRing_stalk k P₁ x

/-- The morphism of projective lines whose affine coordinate is the rational function `f`. -/
noncomputable def projectiveLineMapOfRatFunc (f : RatFunc k) (hf : Transcendental k f) :
    P₁ ⟶ P₁ :=
  Scheme.homOfFunctionField (projectiveLine_valuationRing_stalk (k := k))
    (Spec.map (CommRingCat.ofHom (substitutionOnFunctionField f hf).toRingHom) ≫
      (P₁).fromSpecStalk (genericPoint P₁))
    (Scheme.specMap_comp_fromSpecStalk_genericPoint_comp_over k _
      (substitutionOnFunctionField f hf).commutes)

instance (f : RatFunc k) (hf : Transcendental k f) :
    (projectiveLineMapOfRatFunc f hf).IsOver (Spec (.of k)) := by
  unfold projectiveLineMapOfRatFunc
  exact Scheme.isOver_homOfFunctionField _ _ _

private theorem fromSpecStalk_projectiveLineMapOfRatFunc (f : RatFunc k) (hf : Transcendental k f) :
    (P₁).fromSpecStalk (genericPoint P₁) ≫ projectiveLineMapOfRatFunc f hf =
      Spec.map (CommRingCat.ofHom (substitutionOnFunctionField f hf).toRingHom) ≫
        (P₁).fromSpecStalk (genericPoint P₁) := by
  unfold projectiveLineMapOfRatFunc
  exact Scheme.fromSpecStalk_homOfFunctionField _ _ _

instance (f : RatFunc k) (hf : Transcendental k f) : IsDominant (projectiveLineMapOfRatFunc f hf) :=
  Scheme.Hom.isDominant_of_SpecMap_fromSpecStalk _ _
    (fromSpecStalk_projectiveLineMapOfRatFunc f hf).symm

instance (f : RatFunc k) (hf : Transcendental k f) : IsFinite (projectiveLineMapOfRatFunc f hf) :=
  let : (P₁).IsCurveOver k := projectiveLine_isCurveOver k
  isFinite_of_dominant_properCurveHom (k := k) _

instance (f : RatFunc k) (hf : Transcendental k f) : Surjective (projectiveLineMapOfRatFunc f hf) :=
  let : (P₁).IsCurveOver k := projectiveLine_isCurveOver k
  surjective_of_dominant_properCurveHom (k := k) _

private theorem projectiveLineMapOfRatFunc_functionFieldMap_eq
    (f : RatFunc k) (hf : Transcendental k f) :
    (projectiveLineMapOfRatFunc f hf).functionFieldMap =
      CommRingCat.ofHom (substitutionOnFunctionField f hf).toRingHom :=
  ((Scheme.Hom.eq_functionFieldMap_iff _ _).mpr
    (fromSpecStalk_projectiveLineMapOfRatFunc f hf).symm).symm

/-- Pullback along the scheme map agrees with rational substitution. -/
theorem projectiveLineMapOfRatFunc_functionFieldMap
    (f : RatFunc k) (hf : Transcendental k f) (z : RatFunc k) :
    projectiveLine.functionFieldEquiv k ((projectiveLineMapOfRatFunc f hf).functionFieldMap
      ((projectiveLine.functionFieldEquiv k).symm z)) = ratFuncSubstitution f hf z := by
  rw [projectiveLineMapOfRatFunc_functionFieldMap_eq]
  simp [substitutionOnFunctionField]

/-- The conjugated pullback on function fields equals substitution as an algebra homomorphism. -/
theorem projectiveLineMapOfRatFunc_functionFieldAlgHom
    (f : RatFunc k) (hf : Transcendental k f) :
    let e := projectiveLine.functionFieldEquiv k
    (e.toAlgHom.comp ((projectiveLineMapOfRatFunc f hf).functionFieldAlgHom k)).comp
      e.symm.toAlgHom = ratFuncSubstitution f hf := by
  dsimp only
  apply AlgHom.ext
  intro z
  simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, Scheme.Hom.functionFieldAlgHom_apply]
    using projectiveLineMapOfRatFunc_functionFieldMap f hf z

/-- A dominant morphism of projective lines over `k` is the map of `f` exactly
when its pullback of the affine coordinate is `f`. -/
theorem eq_projectiveLineMapOfRatFunc_iff
    (g : P₁ ⟶ P₁) [g.IsOver (Spec (.of k))] [IsDominant g]
    (f : RatFunc k) (hf : Transcendental k f) :
    g = projectiveLineMapOfRatFunc f hf ↔
      (projectiveLine.functionFieldEquiv k) (g.functionFieldMap
        ((projectiveLine.functionFieldEquiv k).symm RatFunc.X)) = f := by
  constructor
  · rintro rfl
    exact (projectiveLineMapOfRatFunc_functionFieldMap f hf RatFunc.X).trans
      (ratFuncSubstitution_X f hf)
  · intro hg
    let e := projectiveLine.functionFieldEquiv k
    let pullback := (e.toAlgHom.comp (g.functionFieldAlgHom k)).comp e.symm.toAlgHom
    have hpullback : pullback = ratFuncSubstitution f hf := by
      apply RatFunc.algHom_ext
      simpa only [pullback, e, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
        Scheme.Hom.functionFieldAlgHom_apply, ratFuncSubstitution_X] using hg
    apply Scheme.Hom.ext_of_functionFieldMap_eq (Spec (.of k))
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro z
    apply e.injective
    simpa only [pullback, e, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
      Scheme.Hom.functionFieldAlgHom_apply, AlgEquiv.symm_apply_apply] using
      (DFunLike.congr_fun hpullback (e z)).trans
        (projectiveLineMapOfRatFunc_functionFieldMap f hf (e z)).symm

/-- The function-field degree of the map associated to a rational function. -/
theorem projectiveLineMapOfRatFunc_finrank (r : RatFunc k) (hr : Transcendental k r) :
    let A := ((projectiveLineMapOfRatFunc r hr).functionFieldAlgHom k).toRingHom.toAlgebra
    @Module.finrank F₁ F₁ _ _ (@Algebra.toModule _ _ _ _ A) =
      max r.num.natDegree r.denom.natDegree := by
  let φ := projectiveLineMapOfRatFunc r hr
  let : Algebra F₁ F₁ := (φ.functionFieldAlgHom k).toRingHom.toAlgebra
  let e := projectiveLine.functionFieldEquiv k
  let i := e.trans (RatFunc.algEquivOfTranscendental r hr)
  have hc : (algebraMap k⟮r⟯ (RatFunc k)).comp i.toRingEquiv.toRingHom =
      e.toRingEquiv.toRingHom.comp (algebraMap F₁ F₁) := by
    apply RingHom.ext
    intro z
    change (RatFunc.algEquivOfTranscendental r hr (e z) : RatFunc k) =
      e (φ.functionFieldAlgHom k z)
    have hz : e (φ.functionFieldAlgHom k (e.symm (e z))) = ratFuncSubstitution r hr (e z) := by
      rw [Scheme.Hom.functionFieldAlgHom_apply]
      exact projectiveLineMapOfRatFunc_functionFieldMap r hr (e z)
    rw [AlgEquiv.symm_apply_apply] at hz
    exact hz.symm
  exact (Algebra.finrank_eq_of_equiv_equiv i.toRingEquiv e.toRingEquiv hc).trans
    (RatFunc.finrank_eq_max_natDegree r)

/-- The reduced fraction of positive degree is a nonconstant rational function. -/
theorem transcendental_ratFunc_div_of_isCoprime {a c : k[X]} (hc : c ≠ 0)
    (hac : IsCoprime a c) (hdeg : 0 < max a.natDegree c.natDegree) :
    Transcendental k (algebraMap k[X] (RatFunc k) a / algebraMap k[X] (RatFunc k) c) := by
  apply RatFunc.transcendental_of_ne_C
  rintro ⟨r, hr⟩
  have he : a = Polynomial.C r * c := by
    apply RatFunc.algebraMap_injective
    rw [map_mul, RatFunc.algebraMap_C]
    exact (div_eq_iff (RatFunc.algebraMap_ne_zero hc)).mp hr
  have hcu : IsUnit c := hac.symm.isUnit_of_dvd ⟨Polynomial.C r, he.trans (mul_comm _ _)⟩
  have hdc := Polynomial.natDegree_eq_zero_of_isUnit hcu
  have hda : a.natDegree = 0 := by
    rw [he]
    exact Nat.eq_zero_of_le_zero ((Polynomial.natDegree_mul_le ..).trans (by simp [hdc]))
  simp [hda, hdc] at hdeg

end TinyTauDemo
