/-!
# Cyclotomic coprimality and ideal factorization

Differences of distinct prime-order roots of unity control common prime divisors
of Fermat's cyclotomic linear factors. Outside those primes, the product identity
forces each principal factor ideal to be an exact power.
See `/roadmap/index.qmd#prp-unified-coprimality @ 608cc7a4090f010da6b864561df46fa13106e996`.
-/

public section

open Polynomial UniqueFactorizationMonoid

namespace TinyTauDemo

section CyclotomicUnits

variable {B : Type*} [CommRing B] [IsDomain B] {p j : ℕ} {ζ : B}

/-- The geometric sum `1 + ζ + ⋯ + ζ ^ (j - 1)` is a unit already in the
integer algebra generated by a primitive prime-order root of unity. -/
theorem geom_sum_isUnit_int_adjoin (hp : p.Prime) (hζ : IsPrimitiveRoot ζ p)
    (hj : 0 < j) (hjp : j < p) :
    let root : Algebra.adjoin ℤ ({ζ} : Set B) := ⟨ζ, Algebra.subset_adjoin (Set.mem_singleton ζ)⟩
    IsUnit (∑ i ∈ Finset.range j, root ^ i) ∧
      (1 - root) * (∑ i ∈ Finset.range j, root ^ i) = 1 - root ^ j := by
  dsimp only
  let S := Algebra.adjoin ℤ ({ζ} : Set B)
  let root : S := ⟨ζ, Algebra.subset_adjoin (Set.mem_singleton ζ)⟩
  have hroot : IsPrimitiveRoot root p :=
    IsPrimitiveRoot.of_map_of_injective (f := S.val) hζ Subtype.val_injective
  have hcop : j.Coprime p := (Nat.coprime_of_lt_prime hj.ne' hjp hp).symm
  exact ⟨hroot.geom_sum_isUnit hp.two_le hcop, mul_neg_geom_sum root j⟩

/-- The principal ideals of `1 - ζ ^ j` and `1 - ζ` agree for a nonzero exponent
below the prime order of `ζ`. -/
theorem span_one_sub_pow_eq_span_one_sub (hp : p.Prime) (hζ : IsPrimitiveRoot ζ p)
    (hj : 0 < j) (hjp : j < p) :
    (Ideal.span {1 - ζ ^ j} : Ideal B) = Ideal.span {1 - ζ} := by
  have hcop : j.Coprime p := (Nat.coprime_of_lt_prime hj.ne' hjp hp).symm
  have ha := (hζ.associated_sub_one_pow_sub_one_of_coprime hcop).neg_neg
  exact Ideal.span_singleton_eq_span_singleton.mpr <| by
    simpa only [neg_sub] using ha.symm

/-- The ideal of two distinct cyclotomic linear factors contains `1 - ζ`. -/
theorem span_one_sub_le_span_cyclotomic_linear_factors (hp : p.Prime)
    (hζ : IsPrimitiveRoot ζ p) {x y η θ : B} (hxy : IsCoprime x y)
    (hη : η ∈ nthRootsFinset p (1 : B)) (hθ : θ ∈ nthRootsFinset p (1 : B))
    (hne : η ≠ θ) :
    Ideal.span {1 - ζ} ≤ Ideal.span {x + η * y, x + θ * y} := by
  have ha : Associated (1 - ζ) (η - θ) := by
    simpa only [neg_sub] using
      (hζ.nthRootsFinset_pairwise_associated_sub_one_sub_of_prime hp hη hθ hne).neg_left
  rw [Ideal.span_singleton_eq_span_singleton.mpr ha]
  exact span_sub_le_span_linear_factors hxy η θ

end CyclotomicUnits

section DedekindFactorization

variable {B : Type*} [CommRing B] [IsDedekindDomain B] {p : ℕ} {ζ x y z : B}

/-- An ideal away from `1 - ζ` cannot contain two distinct cyclotomic linear factors. -/
theorem cyclotomic_linear_factors_pairwise_outside {q : Ideal B} (hp : p.Prime)
    (hζ : IsPrimitiveRoot ζ p) (hxy : IsCoprime x y) (haway : ¬ 1 - ζ ∈ q) :
    Set.Pairwise (nthRootsFinset p (1 : B))
      (fun η θ ↦ ¬ (x + η * y ∈ q ∧ x + θ * y ∈ q)) := by
  intro η hη θ hθ hne hboth
  apply haway
  have hspan := span_one_sub_le_span_cyclotomic_linear_factors hp hζ hxy hη hθ hne
  have hle : Ideal.span {x + η * y, x + θ * y} ≤ q := by
    rw [Ideal.span_insert, sup_le_iff, Ideal.span_singleton_le_iff_mem,
      Ideal.span_singleton_le_iff_mem]
    exact hboth
  exact hle (hspan (Ideal.subset_span (Set.mem_singleton _)))

open scoped Classical in
/-- For an odd prime exponent, the principal ideals of the cyclotomic linear factors
are powers up to the primes dividing `1 - ζ`. The root ideals are pairwise coprime
and coprime to the ideal of `1 - ζ`. -/
theorem cyclotomic_ideal_decomposition (hp : p.Prime) (hodd : Odd p)
    (hζ : IsPrimitiveRoot ζ p) (hxy : IsCoprime x y) (hz : z ≠ 0)
    (heq : x ^ p + y ^ p = z ^ p) :
    let S := nthRootsFinset p (1 : B)
    let E : Ideal B := Ideal.span {1 - ζ}
    let I (η : B) : Ideal B := Ideal.span {x + η * y}
    ∃ a : B → Ideal B,
      Set.Pairwise S (fun η θ ↦ IsCoprime (a η) (a θ)) ∧
      (∀ η ∈ S, IsCoprime (a η) E) ∧
      ∀ η ∈ S, I η = (a η) ^ p *
        ∏ q ∈ (factorization E).support, q ^ factorization (I η) q := by
  classical
  let S := nthRootsFinset p (1 : B)
  let E : Ideal B := Ideal.span {1 - ζ}
  let I (η : B) : Ideal B := Ideal.span {x + η * y}
  have hlinear : ∏ η ∈ S, (x + η * y) = z ^ p := by
    rw [← hζ.pow_add_pow_eq_prod_add_mul x y hodd, heq]
  have hprod : ∏ η ∈ S, I η = (Ideal.span {z}) ^ p := by
    dsimp only [I]
    rw [Ideal.prod_span_singleton, hlinear, Ideal.span_singleton_pow]
  have hE : E ≠ 0 := by
    intro he
    exact sub_ne_zero.mpr (hζ.ne_one hp.one_lt).symm (Ideal.span_singleton_eq_bot.mp he)
  have hI (η : B) (hη : η ∈ S) : I η ≠ 0 := by
    have hprod0 : (∏ θ ∈ S, (x + θ * y)) ≠ 0 := hlinear.symm ▸ pow_ne_zero _ hz
    intro he
    exact Finset.prod_ne_zero_iff.mp hprod0 η hη (Ideal.span_singleton_eq_bot.mp he)
  refine Ideal.exists_pow_mul_exceptionalFactors_of_prod_eq_pow S hI hE hprod ?_
  intro q _ hq
  have haway : ¬ 1 - ζ ∈ q := by simpa only [E, Ideal.span_singleton_le_iff_mem] using hq
  have hpair := cyclotomic_linear_factors_pairwise_outside hp hζ hxy haway
  simpa only [I, Ideal.span_singleton_le_iff_mem] using hpair

end DedekindFactorization

open scoped Classical in
/-- The cyclotomic ideal decomposition applies after extending any primitive Fermat
solution along an injective map into a Dedekind domain containing a primitive root. -/
theorem PrimitiveFermatSolution.cyclotomic_ideal_decomposition {A B : Type*}
    [CommRing A] [CommRing B] [IsDedekindDomain B] {p : ℕ} {ζ : B} {x y z : A}
    (h : PrimitiveFermatSolution p x y z) (f : A →+* B) (hf : Function.Injective f)
    (hp : p.Prime) (hodd : Odd p) (hζ : IsPrimitiveRoot ζ p) :
    let S := nthRootsFinset p (1 : B)
    let E : Ideal B := Ideal.span {1 - ζ}
    let I (η : B) : Ideal B := Ideal.span {f x + η * f y}
    ∃ a : B → Ideal B,
      Set.Pairwise S (fun η θ ↦ IsCoprime (a η) (a θ)) ∧
      (∀ η ∈ S, IsCoprime (a η) E) ∧
      ∀ η ∈ S, I η = (a η) ^ p *
        ∏ q ∈ (factorization E).support, q ^ factorization (I η) q := by
  have heq : f x ^ p + f y ^ p = f z ^ p := by
    simpa only [map_add, map_pow] using congrArg f h.eq
  exact TinyTauDemo.cyclotomic_ideal_decomposition hp hodd hζ (h.coprime_xy.map f)
    (map_ne_zero_iff f hf |>.2 h.z_ne_zero) heq

section IntegralClosure

variable {A K : Type*} [CommRing A] [Field K] [Algebra A K] {ζ : K} {p : ℕ}

/-- A primitive root of unity in the extension field lifts to the integral closure. -/
theorem isPrimitiveRoot_integralClosure (hp : 0 < p) (hζ : IsPrimitiveRoot ζ p) :
    ∃ root : integralClosure A K, (root : K) = ζ ∧ IsPrimitiveRoot root p := by
  have hint : IsIntegral A ζ :=
    IsIntegral.of_pow hp (by rw [hζ.pow_eq_one]; exact isIntegral_one)
  let root : integralClosure A K := ⟨ζ, hint⟩
  exact ⟨root, rfl, IsPrimitiveRoot.of_map_of_injective (f := (integralClosure A K).val)
    hζ Subtype.val_injective⟩

variable [IsDedekindDomain A] [Algebra (FractionRing A) K] [IsScalarTower A (FractionRing A) K]

private theorem integralClosure_algebraMap_injective :
    Function.Injective (algebraMap A (integralClosure A K)) := by
  have hAK : Function.Injective (algebraMap A K) := by
    rw [IsScalarTower.algebraMap_eq A (FractionRing A) K]
    exact (algebraMap (FractionRing A) K).injective.comp
      (IsFractionRing.injective A (FractionRing A))
  intro x y h
  apply hAK
  simpa only [AlgHom.commutes] using congrArg (integralClosure A K).val h

variable [FiniteDimensional (FractionRing A) K] [Algebra.IsSeparable (FractionRing A) K]

open scoped Classical in
/-- The cyclotomic ideal decomposition in the integral closure of the coefficient
domain in a finite separable extension containing a primitive root. -/
theorem PrimitiveFermatSolution.cyclotomic_ideal_decomposition_integralClosure {x y z : A}
    (h : PrimitiveFermatSolution p x y z) (hp : p.Prime) (hodd : Odd p)
    (hζ : IsPrimitiveRoot ζ p) :
    let B := integralClosure A K
    let f := algebraMap A B
    ∃ root : B, (root : K) = ζ ∧ IsPrimitiveRoot root p ∧
      let S := nthRootsFinset p (1 : B)
      let E : Ideal B := Ideal.span {1 - root}
      let I (η : B) : Ideal B := Ideal.span {f x + η * f y}
      ∃ a : B → Ideal B,
        Set.Pairwise S (fun η θ ↦ IsCoprime (a η) (a θ)) ∧
        (∀ η ∈ S, IsCoprime (a η) E) ∧
        ∀ η ∈ S, I η = (a η) ^ p *
          ∏ q ∈ (factorization E).support, q ^ factorization (I η) q := by
  obtain ⟨root, hcoe, hroot⟩ := isPrimitiveRoot_integralClosure (A := A) hp.pos hζ
  refine ⟨root, hcoe, hroot, ?_⟩
  exact h.cyclotomic_ideal_decomposition _ integralClosure_algebraMap_injective hp hodd hroot

end IntegralClosure

